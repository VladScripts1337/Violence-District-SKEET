local ActualPlayerList
--
local function AddPlayer(Player)
	if not ActualPlayerList then return end
	local Ok, Thumb = pcall(Players.GetUserThumbnailAsync, Players, Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	ActualPlayerList:AddValue(Player.Name, {Image = Ok and Thumb or ""})
end
--
do -- Players
	local PlayerSection = PlayersTab:Section({Name = "Players", Fill = true})
	local Adjust = PlayersTab:Section({Name = "Adjustments", Side = "Right", Fill = true})
	--
	ActualPlayerList = PlayerSection:List({Flag = "PlayerListCurrentPlayer", Size = 300})
	--
	PlayerSection:Button({Name = "View player", Callback = function()
		local Name = Get("PlayerListCurrentPlayer")
		local Player = Name and Players:FindFirstChild(Name)
		if Player then Library:ViewPlayer(Player) end
	end})
	--
	for _, Player in Players:GetPlayers() do
		task.spawn(AddPlayer, Player)
	end
	--
	Adjust:Toggle({Name = "Whitelisted", Flag = "VD_Player_Whitelisted"})
end
--
do -- Settings
	local Section = SettingsTab:Section({Name = "Settings", Fill = true})
	--
	Section:Label({Message = "Menu key (RightShift always works)"}):Keybind({Default = Enum.KeyCode.Insert, UseMode = false, Callback = function(Key)
		Library.UI.CloseBind = Key
	end})
	Section:Label({Message = "Menu color"}):ColorPicker({Default = Library.Theme.Default.Accent, Callback = function(Color)
		Library:UpdateColor("Accent", Color)
		Library:UpdateColor("SecondAccent", Color3.fromRGB(
			math.max(math.floor(Color.R * 255) - 12, 0),
			math.max(math.floor(Color.G * 255) - 12, 0),
			math.max(math.floor(Color.B * 255) - 12, 0)))
	end})
	Section:Slider({Name = "Menu animation speed", Min = 0, Max = 150, Default = 100, Ending = "%", Disable = {"Off", 0, 150}, Callback = function(Value)
		-- 1% -> 0.8s (slow), 150% -> 0.1s (fast), 0 -> instant
		Library.UI.TweenSpeed = Value == 0 and 0 or 0.8 + ((Value - 1) * (0.1 - 0.8)) / (150 - 1)
	end})
	Section:Toggle({Name = "Watermark", Default = true, Callback = function(State)
		if Library.ToggleWatermark then Library:ToggleWatermark(State) end
	end})
	Section:Button({Name = "Disable all", Callback = function() Library:Disable() end})
	Section:Button({Name = "Unload", Confirmation = true, Callback = function() Library:Unload() end})
end
--
do -- Configs
	local Section = ConfigsTab:Section({Name = "Configs", Fill = true})
	local Path = function(Name) return Library.ConfigFolder .. "/" .. Name .. ".cfg" end
	--
	local ConfigList = Section:List({Size = 200, Flag = "CurrentConfig"})
	Library:UpdateConfigList(ConfigList, "Add")
	--
	Section:TextBox({Flag = "ConfigName"})
	Section:Button({Name = "Create config", Callback = function()
		local Name = Get("ConfigName")
		if Name and Name ~= "" and not isfile(Path(Name)) then
			writefile(Path(Name), Library:GetConfig())
			ConfigList:AddValue(Name)
		end
	end})
	Section:Button({Name = "Save config", Callback = function()
		local Name = Get("CurrentConfig")
		if Name then writefile(Path(Name), Library:GetConfig()) end
	end})
	Section:Button({Name = "Load config", Callback = function()
		local Name = Get("CurrentConfig")
		if Name and isfile(Path(Name)) then Library:LoadConfig(readfile(Path(Name))) end
	end})
	Section:Button({Name = "Delete config", Confirmation = true, Callback = function()
		local Name = Get("CurrentConfig")
		if Name and isfile(Path(Name)) and delfile then
			delfile(Path(Name))
			ConfigList:RemoveValue(Name)
			if Autoload.Get() == Name then Autoload.Set(nil) end
		end
	end})
	Section:Button({Name = "Refresh list", Callback = function()
		Library:UpdateConfigList(ConfigList, "Remove")
		Library:UpdateConfigList(ConfigList, "Add")
	end})
	--
	local Initial = "Autoload: " .. (Autoload.Get() or "none")
	Section:Label({Message = Initial})
	for _, Object in Library.UI.ScreenGUI:GetDescendants() do -- the library has no SetText for labels
		if Object:IsA("TextLabel") and Object.Text == Initial then Autoload.Label = Object end
	end
	Section:Button({Name = "Set selected as autoload", Callback = function()
		local Name = Get("CurrentConfig")
		if Name and isfile(Path(Name)) then
			Autoload.Set(Name)
			Library:Notify({Message = "Autoload: " .. Name, Delay = 2})
		else
			Library:Notify({Message = "Select a saved config first", Delay = 2})
		end
	end})
	Section:Button({Name = "Clear autoload", Callback = function()
		Autoload.Set(nil)
		Library:Notify({Message = "Autoload cleared", Delay = 2})
	end})
end
--
do -- Connections
	Library:Connection(Players.PlayerAdded, AddPlayer)
	Library:Connection(Players.PlayerRemoving, function(Player)
		if ActualPlayerList then ActualPlayerList:RemoveValue(Player.Name) end
	end)
end
--
-- ===================== Features =====================
--
local Features = {
	Connections = {}, Highlights = {}, Names = {}, Boxes = {}, Utility = {},
	Map = nil, MapConnections = {}, RenderSteps = {}, Restore = {}, Unloaded = false,
}
--
local MAX_HIGHLIGHTS = 26 -- Roblox renders max 31 Highlights at once; the game uses a few itself
local UPDATE_RATE = 0.2
--
local function Connect(Signal, Callback)
	local Connection = Signal:Connect(function(...)
		local Ok, Error = pcall(Callback, ...)
		if not Ok then warn("[VDSkeet]", Error) end
	end)
	table.insert(Features.Connections, Connection)
	return Connection
end
--
local function BindStep(Name, Priority, Callback)
	RunService:BindToRenderStep(Name, Priority, function(DeltaTime)
		local Ok, Error = pcall(Callback, DeltaTime)
		if not Ok then warn("[VDSkeet] " .. Name .. ":", Error) end
	end)
	table.insert(Features.RenderSteps, Name)
end
--
local function Loop(Interval, Callback)
	task.spawn(function()
		while not Features.Unloaded do
			local Ok, Error = pcall(Callback)
			if not Ok then warn("[VDSkeet]", Error) end
			task.wait(Interval)
		end
	end)
end
--
local GuiContainer = (gethui and gethui()) or CoreGui
local WorldContainer = CoreGui
if not pcall(function()
	local Test = Instance.new("Folder")
	Test.Parent = CoreGui
	Test:Destroy()
end) then
	WorldContainer = GuiContainer
end
--
local HighlightFolder = Instance.new("Folder")
HighlightFolder.Name = "\0"
HighlightFolder.Parent = WorldContainer
--
local BoxGui = Instance.new("ScreenGui")
BoxGui.Name = "\0"
BoxGui.IgnoreGuiInset = true
BoxGui.ResetOnSpawn = false
BoxGui.DisplayOrder = 999
BoxGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
BoxGui.Parent = GuiContainer
--
local function GetColor(FlagName, Default)
	local Value = Get(FlagName)
	return (type(Value) == "table" and Value.Color) or Default
end
--
local function IsKiller(Player)
	return Player.Team ~= nil and Player.Team.Name == "Killer"
end
--
local function IsSurvivor(Player)
	return Player.Team ~= nil and Player.Team.Name == "Survivors"
end
--
local function GetCharacterParts(Player)
	local Character = Player.Character
	if not Character or not Character.Parent then return end
	local Root = Character:FindFirstChild("HumanoidRootPart")
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not Root or not Humanoid or Humanoid.Health <= 0 then return end
	return Character, Root, Humanoid
end
--
local function GetKillerName()
	local Name = Client:GetAttribute("SelectedKiller")
	if typeof(Name) == "string" and Name ~= "" then return Name end
	local Character = Client.Character
	return Character and Character:GetAttribute("MorphedKiller") or ""
end
--
-- ===== Input simulation (uses the player's own keybinds from the game settings) =====
local BINDING_DEFAULTS = {skillcheck = "Space", item = "MouseButton2", ability1 = "MouseButton2"}
local VK = {
	Space = 0x20, Return = 0x0D, Tab = 0x09, LeftShift = 0xA0, RightShift = 0xA1,
	LeftControl = 0xA2, RightControl = 0xA3, LeftAlt = 0xA4, RightAlt = 0xA5,
	Zero = 0x30, One = 0x31, Two = 0x32, Three = 0x33, Four = 0x34, Five = 0x35, Six = 0x36, Seven = 0x37, Eight = 0x38, Nine = 0x39,
}
for Index = 0, 25 do VK[string.char(65 + Index)] = 0x41 + Index end
for Index = 1, 12 do VK["F" .. Index] = 0x6F + Index end
--
local function GetBinding(Action)
	local Value = Client:GetAttribute("kb_" .. Action)
	return (typeof(Value) == "string" and Value ~= "") and Value or BINDING_DEFAULTS[Action]
end
--
local _, VirtualInputManager = pcall(game.GetService, game, "VirtualInputManager")
--
local function PressRaw(Raw)
	if Raw == "MouseButton1" or Raw == "MouseButton2" then
		local Button = Raw == "MouseButton1" and 1 or 2
		local Press = Button == 1 and mouse1press or mouse2press
		local Release = Button == 1 and mouse1release or mouse2release
		if Press and Release then
			Press(); task.wait(0.03); Release()
		else
			local Mouse = UserInputService:GetMouseLocation()
			VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, Button - 1, true, game, 0)
			task.wait(0.03)
			VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, Button - 1, false, game, 0)
		end
		return
	end
	--
	local Code = VK[Raw]
	if keypress and keyrelease and Code then
		keypress(Code); task.wait(0.03); keyrelease(Code)
	else
		local KeyCode = Enum.KeyCode[Raw]
		VirtualInputManager:SendKeyEvent(true, KeyCode, false, game)
		task.wait(0.03)
		VirtualInputManager:SendKeyEvent(false, KeyCode, false, game)
	end
end
--
local function IsBindingHeld(Action)
	local Raw = GetBinding(Action)
	if Raw == "MouseButton1" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
	if Raw == "MouseButton2" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
	local Ok, KeyCode = pcall(function() return Enum.KeyCode[Raw] end)
	return Ok and KeyCode and UserInputService:IsKeyDown(KeyCode) or false
end
--
-- ===== Menu: RightShift always hides/shows =====
Connect(UserInputService.InputBegan, function(Input)
	if Input.KeyCode == Enum.KeyCode.RightShift and Library.UI.CloseBind ~= Enum.KeyCode.RightShift and Library.UI.MainUI then
		Window.Visible = not Window.Visible
		Library:Fade(Window.Visible, Library.Objects, Library.UI.MainUI, 0.2)
	end
end)
--
-- ===================== ESP =====================
--
local function ClassifyUtility(Object)
	if not Object:IsA("Model") then return nil end
	local Name = Object.Name
	local ParentName = Object.Parent and Object.Parent.Name or ""
	--
	if Name == "Generator" then return "Generator" end
	if Name == "Hook" or ParentName == "Hooks" then return "Hook" end
	if Name == "Newpallet" or ParentName == "Pallets" then return "Pallet" end -- decorative "PalletCrate" models are excluded
	if Name == "Window" or ParentName == "Vaults" then return "Vault" end
	if Name == "BearTrap" then return "Beartrap" end
	return nil
end
--
local function TrackUtility(Object)
	local Kind = ClassifyUtility(Object)
	if Kind then
		Features.Utility[Object] = Kind
	end
end
--
local function WatchMap(Map)
	for _, Connection in Features.MapConnections do
		Connection:Disconnect()
	end
	table.clear(Features.MapConnections)
	for Model, Kind in Features.Utility do
		if Kind ~= "Beartrap" or not Model.Parent then Features.Utility[Model] = nil end
	end
	Features.Map = Map
	if not Map then return end
	--
	for _, Descendant in Map:GetDescendants() do
		TrackUtility(Descendant)
	end
	table.insert(Features.MapConnections, Map.DescendantAdded:Connect(TrackUtility))
	table.insert(Features.MapConnections, Map.DescendantRemoving:Connect(function(Descendant)
		Features.Utility[Descendant] = nil
	end))
end
--
for _, Child in Workspace:GetChildren() do
	if Child.Name == "BearTrap" then TrackUtility(Child) end
end
Connect(Workspace.ChildAdded, function(Child)
	if Child.Name == "BearTrap" then TrackUtility(Child) end
end)
--
local UTILITY_FLAGS = {
	Generator = {"VD_Util_Gen", "VD_Util_GenColor", Color3.fromRGB(255, 0, 0)}, -- color comes from RepairProgress
	Hook = {"VD_Util_Hook", "VD_Util_HookColor", Color3.fromRGB(255, 60, 60)},
	Pallet = {"VD_Util_Pallet", "VD_Util_PalletColor", Color3.fromRGB(255, 150, 40)},
	Vault = {"VD_Util_Vault", "VD_Util_VaultColor", Color3.fromRGB(138, 43, 226)},
	Beartrap = {"VD_Util_Trap", "VD_Util_TrapColor", Color3.fromRGB(255, 255, 255)},
}
--
local function GetHighlight(Adornee)
	local Highlight = Features.Highlights[Adornee]
	if not Highlight or not Highlight.Parent then
		Highlight = Instance.new("Highlight")
		Highlight.Name = "\0"
		Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		Highlight.Adornee = Adornee
		Highlight.Parent = HighlightFolder
		Features.Highlights[Adornee] = Highlight
	end
	return Highlight
end
--
local function UpdateHighlights()
	local Camera = Workspace.CurrentCamera
	local CameraPosition = Camera and Camera.CFrame.Position or Vector3.zero
	local Wanted = {}
	--
	if Get("VD_ESP_Chams") then
		for _, Player in Players:GetPlayers() do
			if Player ~= Client then
				local Character = GetCharacterParts(Player)
				if Character then
					table.insert(Wanted, {Adornee = Character, Color = Player.TeamColor.Color, Priority = 0, Distance = 0})
				end
			end
		end
	end
	--
	if Get("VD_ESP_Utility") then
		local Colors, Enabled = {}, {}
		for Kind, Flags in UTILITY_FLAGS do
			Enabled[Kind] = Get(Flags[1])
			Colors[Kind] = GetColor(Flags[2], Flags[3])
		end
		--
		for Model, Kind in Features.Utility do
			if not Model.Parent then
				Features.Utility[Model] = nil
			elseif Enabled[Kind] and not (Kind == "Pallet" and Model:GetAttribute("PalletState") == "Broken") then
				local Pivot = Model:GetPivot().Position
				local Color = Colors[Kind]
				if Kind == "Generator" then
					-- RepairProgress 0..100 (same attribute the game reads in KillerActions): red -> yellow -> green
					local Progress = math.clamp(tonumber(Model:GetAttribute("RepairProgress")) or 0, 0, 100) / 100
					Color = Color3.fromHSV(Progress / 3, 1, 1)
				end
				table.insert(Wanted, {Adornee = Model, Color = Color, Priority = 1, Distance = (Pivot - CameraPosition).Magnitude})
			end
		end
	end
	--
	table.sort(Wanted, function(A, B)
		if A.Priority ~= B.Priority then return A.Priority < B.Priority end
		return A.Distance < B.Distance
	end)
	--
	local Used = {}
	for Index = 1, math.min(#Wanted, MAX_HIGHLIGHTS) do
		local Entry = Wanted[Index]
		local Highlight = GetHighlight(Entry.Adornee)
		Highlight.FillColor = Entry.Color
		Highlight.Enabled = true
		Used[Entry.Adornee] = true
	end
	--
	for Adornee, Highlight in Features.Highlights do
		if not Used[Adornee] then
			Highlight:Destroy()
			Features.Highlights[Adornee] = nil
		end
	end
end
--
local function CreateNameTag()
	local NameTag = Instance.new("BillboardGui")
	NameTag.Name = "\0"
	NameTag.Size = UDim2.new(0, 200, 0, 50)
	NameTag.AlwaysOnTop = true
	NameTag.StudsOffset = Vector3.new(0, 1.8, 0)
	--
	local Tag = Instance.new("TextLabel")
	Tag.Name = "Tag"
	Tag.BackgroundTransparency = 1
	Tag.Position = UDim2.new(0, -50, 0, 0)
	Tag.Size = UDim2.new(0, 300, 0, 20)
	Tag.TextSize = 15
	Tag.TextStrokeColor3 = Color3.new(0, 0, 0)
	Tag.TextStrokeTransparency = 0.4
	Tag.Font = Enum.Font.SourceSansBold
	Tag.TextScaled = false
	Tag.Parent = NameTag
	--
	NameTag.Parent = HighlightFolder
	return NameTag
end
--
local function UpdateNames()
	local Seen = {}
	--
	if Get("VD_ESP_Name") then
		for _, Player in Players:GetPlayers() do
			if Player ~= Client then
				local Character = GetCharacterParts(Player)
				local Head = Character and Character:FindFirstChild("Head")
				if Head then
					local NameTag = Features.Names[Player]
					if not NameTag or not NameTag.Parent then
						NameTag = CreateNameTag()
						Features.Names[Player] = NameTag
					end
					NameTag.Adornee = Head
					NameTag.Tag.Text = Player.Name
					NameTag.Tag.TextColor3 = Player.TeamColor.Color
					Seen[Player] = true
				end
			end
		end
	end
	--
	for Player, NameTag in Features.Names do
		if not Seen[Player] then
			NameTag:Destroy()
			Features.Names[Player] = nil
		end
	end
end
--
local function CreateBox()
	local Outline = Instance.new("Frame")
	Outline.BackgroundTransparency = 1
	Outline.BorderSizePixel = 0
	Outline.ZIndex = 1
	Outline.Visible = false
	local OutlineStroke = Instance.new("UIStroke")
	OutlineStroke.Color = Color3.new(0, 0, 0)
	OutlineStroke.Thickness = 3
	OutlineStroke.Parent = Outline
	Outline.Parent = BoxGui
	--
	local Box = Instance.new("Frame")
	Box.BackgroundTransparency = 1
	Box.BorderSizePixel = 0
	Box.ZIndex = 2
	Box.Visible = false
	local BoxStroke = Instance.new("UIStroke")
	BoxStroke.Thickness = 1
	BoxStroke.Parent = Box
	Box.Parent = BoxGui
	--
	return {Outline = Outline, Box = Box, Stroke = BoxStroke}
end
--
local function RemoveBox(Player)
	local Entry = Features.Boxes[Player]
	if Entry then
		Entry.Outline:Destroy()
		Entry.Box:Destroy()
		Features.Boxes[Player] = nil
	end
end
--
local function UpdateBoxes()
	local Camera = Workspace.CurrentCamera
	local Seen = {}
	--
	if Get("VD_ESP_Box") and Camera then
		for _, Player in Players:GetPlayers() do
			if Player ~= Client then
				local Character, Root, Humanoid = GetCharacterParts(Player)
				local Head = Character and Character:FindFirstChild("Head")
				if Head then
					local Legs = Humanoid.RigType == Enum.HumanoidRigType.R6 and 2 or Humanoid.HipHeight
					local Top, TopVisible = Camera:WorldToViewportPoint(Head.Position + Vector3.new(0, Head.Size.Y / 2 + 0.2, 0))
					local Bottom, BottomVisible = Camera:WorldToViewportPoint(Root.Position - Vector3.new(0, Root.Size.Y / 2 + Legs + 0.1, 0))
					--
					if (TopVisible or BottomVisible) and Top.Z > 0 and Bottom.Z > 0 then
						local Entry = Features.Boxes[Player] or CreateBox()
						Features.Boxes[Player] = Entry
						--
						local Height = math.abs(Bottom.Y - Top.Y)
						local Width = Height * 0.55
						local CenterX = (Top.X + Bottom.X) / 2
						local Position = UDim2.fromOffset(math.floor(CenterX - Width / 2), math.floor(math.min(Top.Y, Bottom.Y)))
						local Size = UDim2.fromOffset(math.floor(Width), math.floor(Height))
						--
						Entry.Outline.Position, Entry.Outline.Size = Position, Size
						Entry.Box.Position, Entry.Box.Size = Position, Size
						Entry.Stroke.Color = Player.TeamColor.Color
						Entry.Outline.Visible = true
						Entry.Box.Visible = true
						Seen[Player] = true
					end
				end
			end
		end
	end
	--
	for Player, Entry in Features.Boxes do
		if not Seen[Player] then
			if Player.Parent then
				Entry.Outline.Visible = false
				Entry.Box.Visible = false
			else
				RemoveBox(Player)
			end
		end
	end
end
--
-- ===================== Aimbots =====================
--
local PROJECTILES = { -- from the game's modules: ChainProjectile.SPEED, SpearMath.Speed/Gravity, FlaskTrajectory.TravelSpeed
	Butcher = {Speed = 140, Gravity = 0},
	Veil = {Speed = 165, Gravity = 98.1},
	Cure = {Speed = 70, Gravity = 0},
	Doctor = {Speed = 70, Gravity = 0},
}
--
local function GetPing()
	local Ok, Ping = pcall(Client.GetNetworkPing, Client)
	return (Ok and type(Ping) == "number") and math.clamp(Ping, 0, 0.5) or 0.08
end
--
local function PredictPosition(Root, Origin, Projectile)
	local Velocity = Root.AssemblyLinearVelocity
	Velocity = Vector3.new(Velocity.X, math.clamp(Velocity.Y, -20, 20) * 0.5, Velocity.Z)
	local Time = GetPing()
	if Projectile then
		Time += (Root.Position - Origin).Magnitude / Projectile.Speed
	end
	local Position = Root.Position + Velocity * Time
	if Projectile and Projectile.Gravity > 0 then
		local Travel = (Position - Origin).Magnitude / Projectile.Speed
		Position += Vector3.new(0, 0.5 * Projectile.Gravity * Travel * Travel, 0)
	end
	return Position
end
--
-- Wallcheck: ray from the camera to the target part. Characters and the camera (killer VM) are ignored.
-- Everything visible blocks, except: invisible parts (Transparency >= 0.9: map colliders, hitboxes),
-- foliage (leaves / ferns / bushes / grass) and tiny non-collidable debris.
local WallParams = RaycastParams.new()
WallParams.FilterType = Enum.RaycastFilterType.Exclude
WallParams.IgnoreWater = true
--
local FOLIAGE = {"leaf", "leaves", "fern", "bush", "grass", "foliage"}
--
local function IsSeeThrough(Part)
	if not Part:IsA("BasePart") then return false end
	if Part:IsA("Terrain") then return false end
	if Part.Transparency >= 0.9 then return true end
	if not Part.CanCollide and Part.Size.Magnitude < 4 then return true end
	local Name = (Part.Name .. " " .. (Part.Parent and Part.Parent.Name or "")):lower()
	for _, Word in FOLIAGE do
		if Name:find(Word, 1, true) then return true end
	end
	return false
end
--
local function BuildIgnoreList(Camera)
	local List = {Camera}
	for _, Player in Players:GetPlayers() do
		if Player.Character then table.insert(List, Player.Character) end
	end
	return List
end
--
local function IsVisible(Origin, Point, IgnoreList)
	local Direction = Point - Origin
	if Direction.Magnitude < 0.1 then return true end
	local Excluded = table.clone(IgnoreList)
	for _ = 1, 8 do
		WallParams.FilterDescendantsInstances = Excluded
		local Result = Workspace:Raycast(Origin, Direction, WallParams)
		if not Result then return true end
		if not IsSeeThrough(Result.Instance) then return false end
		table.insert(Excluded, Result.Instance) -- see-through: keep going past it
	end
	return false
end
--
-- returns the root part and the part to aim at (root if visible, otherwise head)
local function GetAimPart(Origin, Character, Root, IgnoreList)
	if not IgnoreList then return Root end
	if IsVisible(Origin, Root.Position, IgnoreList) then return Root end
	local Head = Character:FindFirstChild("Head")
	if Head and IsVisible(Origin, Head.Position, IgnoreList) then return Head end
	return nil
end
--
local function FindTarget(Camera, Filter, MinDot, Wallcheck)
	local Best, BestPart, BestDot = nil, nil, MinDot
	local CameraCFrame = Camera.CFrame
	local IgnoreList = Wallcheck and BuildIgnoreList(Camera) or nil
	for _, Player in Players:GetPlayers() do
		if Player ~= Client and Filter(Player) then
			local Character, Root = GetCharacterParts(Player)
			if Root and not Character:GetAttribute("IsHooked") and not Character:GetAttribute("IsCarried") then
				local Direction = Root.Position - CameraCFrame.Position
				if Direction.Magnitude > 0 then
					local Dot = CameraCFrame.LookVector:Dot(Direction.Unit)
					if Dot > BestDot then
						local Part = GetAimPart(CameraCFrame.Position, Character, Root, IgnoreList)
						if Part then
							Best, BestPart, BestDot = Root, Part, Dot
						end
					end
				end
			end
		end
	end
	return Best, BestPart
end
--
local function AimAt(Camera, Position, SmoothFlag, DeltaTime)
	local Smooth = math.max(Get(SmoothFlag) or 1, 1)
	local Alpha = 1 - (1 - 1 / Smooth) ^ (DeltaTime * 60) -- frame-rate independent
	local Goal = CFrame.lookAt(Camera.CFrame.Position, Position)
	Camera.CFrame = Camera.CFrame:Lerp(Goal, math.clamp(Alpha, 0, 1))
end
--
local function UpdateAimbots(DeltaTime)
	local Camera = Workspace.CurrentCamera
	if not Camera or Camera.CameraType ~= Enum.CameraType.Custom then return end
	if Window.Visible and Library.UI.MainUI and Library:SectionDragging(Library.UI.MainUI) then return end
	local Origin = Camera.CFrame.Position
	--
	if IsKiller(Client) then
		if not Get("VD_KAim_Enabled") then return end
		local Root, Part = FindTarget(Camera, IsSurvivor, 0.5, not Get("VD_KAim_AutoWall")) -- AutoWall on = wallcheck off
		if not Root then return end
		local Position = Part.Position
		if Get("VD_KAim_Predict") then
			Position += PredictPosition(Root, Origin, PROJECTILES[GetKillerName()]) - Root.Position
		end
		AimAt(Camera, Position, "VD_KAim_Smooth", DeltaTime)
	else
		if not Get("VD_Aim_Enabled") then return end
		if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
		local Root, Part = FindTarget(Camera, IsKiller, -2, Get("VD_Aim_Wallcheck"))
		if not Root then return end
		local Position = Part.Position
		if Get("VD_Aim_Predict") then
			Position += PredictPosition(Root, Origin, nil) - Root.Position
		end
		Position += Camera.CFrame.RightVector * (Get("VD_Aim_OffsetX") or 0) -- screen-space offset: negative = left
		AimAt(Camera, Position, "VD_Aim_Smooth", DeltaTime)
	end
end
--
local TOGGLE_KEYS = {
	{Key = "VD_KAim_Key", Toggle = function() return KillerAimToggle end, Name = "Killer aimbot"},
	{Key = "VD_KAim_AutoWallKey", Toggle = function() return AutoWallToggle end, Name = "AutoWall"},
	{Key = "VD_Speed_Key", Toggle = function() return SpeedToggle end, Name = "Speed changer"},
	{Key = "VD_Noclip_Key", Toggle = function() return NoclipToggle end, Name = "Noclip"},
	{Key = "VD_Misc_ThirdPersonKey", Toggle = function() return ThirdPersonToggle end, Name = "Third person"},
}
--
local function KeyMatches(Flag, Input)
	local Keybind = Library.Flags[Flag]
	local Key = Keybind and Keybind.RegKeybind
	if typeof(Key) ~= "EnumItem" then return false end
	return (Key.EnumType == Enum.KeyCode and Input.KeyCode == Key) or (Key.EnumType == Enum.UserInputType and Input.UserInputType == Key)
end
--
Connect(UserInputService.InputBegan, function(Input, Processed)
	if Processed then return end
	if KeyMatches("VD_Emote_Key", Input) then
		if Emote.Track and Emote.Track.IsPlaying then Emote.Stop() else Emote.Play() end
	end
	if KeyMatches("VD_Anim_Key", Input) and Anim.Play then
		if Anim.Track and Anim.Track.IsPlaying then Anim.Stop() else Anim.Play() end
	end
	for _, Entry in TOGGLE_KEYS do
		local Keybind = Library.Flags[Entry.Key]
		local Key = Keybind and Keybind.RegKeybind
		local ToggleObject = Entry.Toggle()
		if ToggleObject and typeof(Key) == "EnumItem" then
			local Match = (Key.EnumType == Enum.KeyCode and Input.KeyCode == Key) or (Key.EnumType == Enum.UserInputType and Input.UserInputType == Key)
			if Match then
				ToggleObject:Set(not ToggleObject:Get())
				Library:Notify({Message = Entry.Name .. ": " .. (ToggleObject:Get() and "ON" or "OFF"), Delay = 1.5})
			end
		end
	end
end)
--
-- ===================== Skill checks (generator / heal / beartrap) =====================
--
local SKILL_WINDOW = {104, 114} -- (Line.Rotation - Goal.Rotation) % 360, same window as VD Rewrite "Auto Perfect"
local Skill = {Done = false, GoalRotation = nil, LastLine = nil, LastTime = 0, Source = nil, SourceTime = 0}
--
pcall(function()
	Connect(Remotes.Generator.SkillCheckEvent.OnClientEvent, function() Skill.Source, Skill.SourceTime = "Generator", os.clock() end)
	Connect(Remotes.Healing.SkillCheckEvent.OnClientEvent, function() Skill.Source, Skill.SourceTime = "Healing", os.clock() end)
end)
--
local function GetActiveCheck()
	local PlayerGui = Client:FindFirstChildOfClass("PlayerGui")
	if not PlayerGui then return nil end
	for _, Name in {"SkillCheckPromptGui", "SkillCheckPromptGui-con"} do
		local Gui = PlayerGui:FindFirstChild(Name)
		local Check = Gui and Gui:FindFirstChild("Check")
		if Check and Check.Visible and (not Gui:IsA("ScreenGui") or Gui.Enabled) then
			return Check
		end
	end
	return nil
end
--
local function UpdateSkillCheck(DeltaTime)
	local Check = GetActiveCheck()
	if not Check then
		Skill.Done, Skill.LastLine, Skill.GoalRotation = false, nil, nil
		return
	end
	--
	local Line = Check:FindFirstChild("Line")
	local TrapGoal, TrapPerfect = Check:FindFirstChild("TrapGoal"), Check:FindFirstChild("TrapPerfect")
	local Character = Client.Character
	local IsTrap = (TrapGoal and TrapGoal.Visible) or (TrapPerfect and TrapPerfect.Visible) or (Character and Character:GetAttribute("Trapped"))
	local Goal
	--
	if IsTrap then
		if not Get("VD_Auto_Beartrap") then return end
		Goal = (TrapPerfect and TrapPerfect.Visible and TrapPerfect) or (TrapGoal and TrapGoal.Visible and TrapGoal) or Check:FindFirstChild("Goal")
	else
		local Source = (os.clock() - Skill.SourceTime < 3) and Skill.Source or nil
		local GenOn, HealOn = Get("VD_Auto_SkillCheck"), Get("VD_Auto_Heal")
		if Source == "Generator" and not GenOn then return end
		if Source == "Healing" and not HealOn then return end
		if Source == nil and not (GenOn or HealOn) then return end
		Goal = Check:FindFirstChild("Goal")
	end
	if not Line or not Goal then return end
	--
	if Skill.GoalRotation ~= Goal.Rotation then
		Skill.GoalRotation, Skill.Done, Skill.LastLine = Goal.Rotation, false, nil
	end
	if Skill.Done then return end
	--
	local Now, Rotation = os.clock(), Line.Rotation
	local Speed = 0
	if Skill.LastLine and Now > Skill.LastTime then
		Speed = math.clamp(((Rotation - Skill.LastLine) % 360) / (Now - Skill.LastTime), 0, 1500)
	end
	Skill.LastLine, Skill.LastTime = Rotation, Now
	--
	local Offset = IsTrap and (Get("VD_Trap_Offset") or 0) or 0
	local Lead = math.clamp(Speed * DeltaTime, 0, 10) -- input lands one frame later
	local Diff = (Rotation - Goal.Rotation) % 360
	if Diff >= SKILL_WINDOW[1] + Offset - Lead and Diff <= SKILL_WINDOW[2] + Offset - Lead then
		Skill.Done = true
		task.spawn(PressRaw, GetBinding("skillcheck"))
	end
end
--
-- ===================== Auto parry (ParryClient:Parry from the game's module) =====================
--
local ATTACK_ANIMS = {
	["rbxassetid://139369275981139"] = true, ["rbxassetid://133963973694098"] = true, ["rbxassetid://132817836308238"] = true,
	["rbxassetid://82666958311998"] = true, ["rbxassetid://78432063483146"] = true, ["rbxassetid://80411309607666"] = true,
	["rbxassetid://74968262036854"] = true, ["rbxassetid://111920872708571"] = true, ["rbxassetid://138720291317243"] = true,
	["rbxassetid://130593238885843"] = true, ["rbxassetid://106871536134254"] = true, ["rbxassetid://78935059863801"] = true,
}
local Parry = {Instances = setmetatable({}, {__mode = "k"}), LastScan = 0, LastParry = 0, Hooked = false, Watched = setmetatable({}, {__mode = "k"})}
--
local function IsParryInstance(Value)
	if type(Value) ~= "table" or rawget(Value, "parryEvent") == nil or rawget(Value, "tool") == nil then return false end
	local Meta = getmetatable(Value)
	return type(Meta) == "table" and type(rawget(Meta, "Parry")) == "function"
end
--
local function HookParryClient()
	if Parry.Hooked then return end
	Parry.Hooked = true
	pcall(function()
		local ParryClient = require(ReplicatedStorage.Modules.Items.ParryingDagger.ParryClient)
		local OldNew = ParryClient.new
		ParryClient.new = function(...)
			local Instance_ = OldNew(...)
			Parry.Instances[Instance_] = true
			return Instance_
		end
	end)
end
--
local function GetParryClient()
	local Character = Client.Character
	if not Character then return nil end
	for Instance_ in Parry.Instances do
		if Instance_.character == Character and Instance_.tool and Instance_.tool:IsDescendantOf(Character) then
			return Instance_
		end
	end
	if getgc and os.clock() - Parry.LastScan > 5 then
		Parry.LastScan = os.clock()
		for _, Value in getgc(true) do
			if IsParryInstance(Value) then
				Parry.Instances[Value] = true
			end
		end
		for Instance_ in Parry.Instances do
			if Instance_.character == Character and Instance_.tool and Instance_.tool:IsDescendantOf(Character) then
				return Instance_
			end
		end
	end
	return nil
end
--
local function DoParry()
	if os.clock() - Parry.LastParry < 0.6 then return end
	local Character = Client.Character
	if not Character or Character:GetAttribute("IsHooked") or Character:GetAttribute("Trapped") or Character:GetAttribute("IsCarried") then return end
	if not (Character:FindFirstChild("Parrying Dagger", true) or Character:FindFirstChild("Parry Dagger", true)) then return end -- dagger must be equipped
	Parry.LastParry = os.clock()
	--
	local Client_ = GetParryClient()
	if Client_ then
		task.spawn(Client_.Parry, Client_)
	else
		task.spawn(PressRaw, GetBinding("item"))
	end
end
--
local function OnKillerAnimation(Killer, Track)
	if not Get("VD_Auto_Parry") or IsKiller(Client) then return end
	local _, KillerRoot = GetCharacterParts(Killer)
	local _, MyRoot = GetCharacterParts(Client)
	if not KillerRoot or not MyRoot then return end
	--
	local Offset = MyRoot.Position - KillerRoot.Position
	local Distance = Offset.Magnitude
	if Distance > (Get("VD_Parry_Dist") or 10) or Distance <= 0 then return end
	--
	local AnimationId = Track.Animation and Track.Animation.AnimationId or ""
	local Known = ATTACK_ANIMS[AnimationId]
	local Facing = KillerRoot.CFrame.LookVector:Dot(Offset.Unit) > 0.6
	local Priority = Track.Priority
	local IsAction = Priority ~= Enum.AnimationPriority.Core and Priority.Value >= Enum.AnimationPriority.Action.Value
	if Known or (Facing and IsAction) then
		DoParry()
	end
end
--
local function WatchCharacterAnimations(Player, Character)
	local Humanoid = Character:WaitForChild("Humanoid", 10)
	local Animator = Humanoid and Humanoid:WaitForChild("Animator", 10)
	if not Animator or Parry.Watched[Animator] then return end
	Parry.Watched[Animator] = true
	Connect(Animator.AnimationPlayed, function(Track)
		if IsKiller(Player) then OnKillerAnimation(Player, Track) end
	end)
end
--
local function WatchPlayer(Player)
	if Player == Client then return end
	if Player.Character then task.spawn(WatchCharacterAnimations, Player, Player.Character) end
	Connect(Player.CharacterAdded, function(Character) WatchCharacterAnimations(Player, Character) end)
end
for _, Player in Players:GetPlayers() do WatchPlayer(Player) end
Connect(Players.PlayerAdded, WatchPlayer)
--
-- ===================== Survivor movement =====================
--
local TURN_PATCH = {LIGHT_TURN_RESPONSE = 1, TURN_RESPONSE_CURVE = 0, TRAVEL_TURN_RATE = 1000, STEERING_FRICTION = 1000, JITTER_MIN_CHANGES = 1e9}
local Turn = {Tables = nil, Original = {}, Applied = false}
--
local function GetMovementTables()
	if Turn.Tables then return Turn.Tables end
	local Found = {}
	pcall(function()
		local Module = require(ReplicatedStorage.Modules.Survivors.SurvivorMovement)
		if type(Module) == "table" then Found[Module] = true end
	end)
	if getgc then
		for _, Value in getgc(true) do
			if type(Value) == "table" and rawget(Value, "LIGHT_TURN_LIMIT") ~= nil and rawget(Value, "STEERING_FRICTION") ~= nil then
				Found[Value] = true
			end
		end
	end
	Turn.Tables = Found
	return Found
end
--
local function SetTurnPatch(State)
	if State == Turn.Applied then return end
	for Table in GetMovementTables() do
		Turn.Original[Table] = Turn.Original[Table] or {}
		for Key, Value in TURN_PATCH do
			if State then
				if Turn.Original[Table][Key] == nil then Turn.Original[Table][Key] = rawget(Table, Key) end
				rawset(Table, Key, Value)
			elseif Turn.Original[Table][Key] ~= nil then
				rawset(Table, Key, Turn.Original[Table][Key])
			end
		end
	end
	Turn.Applied = State
end
--
local Speed = {Character = nil, Base = 1, Applied = nil}
--
local function UpdateSpeed()
	local Character = Client.Character
	if not Character then return end
	if Speed.Character ~= Character then
		Speed.Character, Speed.Base, Speed.Applied = Character, 1, nil
	end
	local Current = Character:GetAttribute("speedboost") or 1
	--
	if Get("VD_Speed_On") then
		if Speed.Applied == nil or math.abs(Current - Speed.Applied) > 1e-4 then
			Speed.Base = Current -- the game changed speedboost (slow, boost, reset): keep it as the new base
		end
		local Target = Speed.Base * math.clamp(Get("VD_Speed_Value") or 1, 1, 1.3)
		if math.abs(Current - Target) > 1e-4 then
			Character:SetAttribute("speedboost", Target)
		end
		Speed.Applied = Target
	elseif Speed.Applied then
		if math.abs(Current - Speed.Applied) < 1e-4 then
			Character:SetAttribute("speedboost", Speed.Base)
		end
		Speed.Applied = nil
	end
end
--
-- Crouch keeps the same speed while Speed changer is on (SurvivorAnimationsController.crouchSpeed, default 6)
local Crouch = {Controller = nil, LastScan = 0, Original = nil}
--
local function GetSurvivorController()
	local Character = Client.Character
	if not Character then return nil end
	local Controller = Crouch.Controller
	if Controller and rawget(Controller, "character") == Character then return Controller end
	Crouch.Controller = nil
	if not getgc or os.clock() - Crouch.LastScan < 3 then return nil end
	Crouch.LastScan = os.clock()
	for _, Value in getgc(true) do
		if type(Value) == "table" and rawget(Value, "crouchSpeed") ~= nil and rawget(Value, "runSpeed") ~= nil
			and rawget(Value, "normalWalkSpeed") ~= nil and rawget(Value, "character") == Character then
			Crouch.Controller = Value
			Crouch.Original = Crouch.Original or rawget(Value, "crouchSpeed")
			return Value
		end
	end
	return nil
end
--
local function UpdateCrouchSpeed()
	if IsKiller(Client) then return end
	local Wanted = Get("VD_Speed_On") == true
	if not Wanted and not Crouch.Applied then return end
	local Controller = GetSurvivorController()
	if not Controller then return end
	if Wanted then
		local Normal = rawget(Controller, "isShiftHeld") and rawget(Controller, "runSpeed") or rawget(Controller, "normalWalkSpeed")
		if type(Normal) == "number" then rawset(Controller, "crouchSpeed", Normal) end
		Crouch.Applied = true
	else
		rawset(Controller, "crouchSpeed", Crouch.Original or 6)
		Crouch.Applied = false
	end
end
--
-- ===================== Killer =====================
--
local Killer = {JasonStunned = false, Lunge = false, StunConnections = {}, Hitboxes = {}, HitboxBoxes = {}, HiddenHooked = false, NamecallHooked = false}
--
-- No pallet stun. The game stuns the killer two ways:
--  1) Pallet.Jason.Stun -> KillerActionController.handleStun plays "StunAnimation" and waits for it (waitForActionTrack);
--     stopping that track makes the game itself send Stunover(character), clear isStunned and restore WalkSpeed.
--  2) server attribute IsStunned on the character -> updateSpeed() keeps WalkSpeed = 0; we clear it locally.
local function StopStunTracks()
	local _, _, Humanoid = GetCharacterParts(Client)
	local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then return false end
	local Stopped = false
	for _, Track in Animator:GetPlayingAnimationTracks() do
		local Name = Track.Animation and Track.Animation.Name or ""
		if Name:lower():find("stun", 1, true) then
			Track:Stop(0)
			Stopped = true
		end
	end
	return Stopped
end
--
local function OnStun()
	Killer.JasonStunned = true
	task.delay(5, function() Killer.JasonStunned = false end)
	if not (Get("VD_K_NoPalletStun") and IsKiller(Client)) then return end
	task.spawn(function()
		for _ = 1, 40 do -- ~0.6 s: catch the stun track as soon as handleStun starts it
			if StopStunTracks() then return end
			RunService.Heartbeat:Wait()
		end
		-- no stun track (some killers): end the stun on the server ourselves, same call the game makes
		local Character = Client.Character
		if Character then pcall(function() Remotes.Pallet.Jason.Stunover:FireServer(Character) end) end
	end)
end
--
pcall(function()
	local Stun = Remotes.Pallet.Jason:WaitForChild("Stun", 5)
	if Stun then
		table.insert(Features.Connections, Stun.OnClientEvent:Connect(function() pcall(OnStun) end))
	end
end)
--
local function UpdateStunAttribute()
	if not (Get("VD_K_NoPalletStun") and IsKiller(Client)) then return end
	local Character = Client.Character
	if Character and Character:GetAttribute("IsStunned") == true then
		Character:SetAttribute("IsStunned", false) -- local only: the game's IsStunned handler then restores speed
	end
end
--
local function UpdateNoSlowdown()
	if not Get("VD_K_NoSlowdown") or not IsKiller(Client) or Killer.JasonStunned then return end
	local Character, _, Humanoid = GetCharacterParts(Client)
	if not Character then return end
	if Character:GetAttribute("IsStunned") or Character:GetAttribute("Immobile") then return end
	local Wanted = (Character:GetAttribute("Speed") or 0) * (Character:GetAttribute("speedboost") or 1)
	if Wanted > 0 and Humanoid.WalkSpeed < Wanted then
		Humanoid.WalkSpeed = Wanted
	end
end
--
local function UpdateLunge()
	local Character = Client.Character
	if not Character then return end
	if Get("VD_K_InfLunge") and IsKiller(Client) then
		if Character:GetAttribute("lungeboost") ~= 999 then Character:SetAttribute("lungeboost", 999) end
		Killer.Lunge = true
	elseif Killer.Lunge then
		Character:SetAttribute("lungeboost", 1)
		Killer.Lunge = false
	end
end
--
local function UpdateHitboxes()
	local Enabled = Get("VD_K_Hitbox") and IsKiller(Client)
	local Scale = math.clamp(Get("VD_K_HitboxSize") or 1, 1, 3)
	local Seen = {}
	--
	if Enabled then
		for _, Player in Players:GetPlayers() do
			if Player ~= Client and IsSurvivor(Player) then
				local _, Root = GetCharacterParts(Player)
				if Root then
					local Original = Killer.Hitboxes[Root]
					if not Original then
						Original = {Size = Root.Size, Transparency = Root.Transparency, CanCollide = Root.CanCollide}
						Killer.Hitboxes[Root] = Original
					end
					local Size = Original.Size * Scale
					if Root.Size ~= Size then Root.Size = Size end
					Root.Transparency = 0.8
					Root.CanCollide = false
					Seen[Root] = true
					--
					local Box = Killer.HitboxBoxes[Root]
					if not Box or not Box.Parent then
						Box = Instance.new("SelectionBox")
						Box.Name = "\0"
						Box.LineThickness = 0.04
						Box.SurfaceTransparency = 0.85
						Box.Adornee = Root
						Box.Parent = HighlightFolder
						Killer.HitboxBoxes[Root] = Box
					end
					local Color = GetColor("VD_K_HitboxColor", Color3.fromRGB(255, 40, 40))
					Box.Color3 = Color
					Box.SurfaceColor3 = Color
				end
			end
		end
	end
	--
	for Root, Original in Killer.Hitboxes do
		if not Seen[Root] then
			if Root.Parent then
				Root.Size = Original.Size
				Root.Transparency = Original.Transparency
				Root.CanCollide = Original.CanCollide
			end
			Killer.Hitboxes[Root] = nil
		end
	end
	for Root, Box in Killer.HitboxBoxes do
		if not Seen[Root] then
			Box:Destroy()
			Killer.HitboxBoxes[Root] = nil
		end
	end
end
--
local function InstallNamecallHook()
	if Killer.NamecallHooked or not hookmetamethod or not getnamecallmethod then return end
	Killer.NamecallHooked = true
	local GotBlinded = Remotes.Items.Flashlight:FindFirstChild("GotBlinded")
	local BasicAttack = Remotes.Attacks:FindFirstChild("BasicAttack")
	local OldNamecall
	OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(Self, ...)
		if not Features.Unloaded and (Self == GotBlinded or Self == BasicAttack) and getnamecallmethod() == "FireServer" then
			if Self == GotBlinded and Get("VD_K_AntiBlind") then
				return nil
			end
			if Self == BasicAttack and not checkcaller() then
				Killer.LastAttack = {Args = table.pack(...), Time = os.clock(), Repeated = false}
			end
		end
		return OldNamecall(Self, ...)
	end))
end
--
-- Double tap: the server decides hits (BasicAttack has no target) and answers with AfterAttack(result).
-- Two requests in one frame are dropped by the server's attack lock, so the second attack is sent
-- right after the server confirms a hit (result is not Cancel / Nothing / Parried / Wall...).
local function OnAfterAttack(Result)
	if not (Get("VD_K_DoubleTap") and IsKiller(Client)) then return end
	local Last = Killer.LastAttack
	if not Last or Last.Repeated or os.clock() - Last.Time > 3 then return end
	if typeof(Result) ~= "string" or Result == "Cancel" or Result == "Nothing" or Result == "Parried" or Result:find("Wall") then return end
	Last.Repeated = true
	task.wait(0.05)
	local BasicAttack = Remotes.Attacks:FindFirstChild("BasicAttack")
	if BasicAttack then
		BasicAttack:FireServer(table.unpack(Last.Args, 1, Last.Args.n))
	end
end
--
pcall(function()
	local AfterAttack = Remotes.Attacks:WaitForChild("AfterAttack", 5)
	if AfterAttack then
		table.insert(Features.Connections, AfterAttack.OnClientEvent:Connect(function(Result) pcall(OnAfterAttack, Result) end))
	end
end)
--
local function InstallHiddenHook()
	if Killer.HiddenHooked or not hookfunction then return end
	Killer.HiddenHooked = true
	local OldDelay
	OldDelay = hookfunction(task.delay, newcclosure(function(Time, ...)
		if not Features.Unloaded and not checkcaller() and Get("VD_K_HiddenNoCD") and type(Time) == "number" and Time > 0.5 then
			if string.find(debug.traceback(nil, 2) or "", "Powers") then
				return OldDelay(0.5, ...)
			end
		end
		return OldDelay(Time, ...)
	end))
end
--
local function UpdateAntiBlindOverlay()
	if not Get("VD_K_AntiBlind") then return end
	local PlayerGui = Client:FindFirstChildOfClass("PlayerGui")
	if not PlayerGui then return end
	for _, Object in PlayerGui:GetDescendants() do
		if Object.Name == "Overlay" and Object:IsA("GuiObject") and Object:FindFirstChild("Smoke") and Object:FindFirstChild("Streak") then
			Object.Visible = false -- FlashBlindEffect overlay
		end
	end
end
