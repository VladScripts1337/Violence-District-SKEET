	AnimList = SelectableList(Main:List({Flag = "VD_Anim_Name", Size = LIST_ROWS_5}))
	Main:Button({Name = "Play animation", Callback = function() if Anim.Play then Anim.Play() end end})
	Main:Button({Name = "Stop animation", Callback = function() if Anim.Stop then Anim.Stop() end end})
	Main:Button({Name = "Refresh animation list", Callback = function() if Anim.Refresh then Anim.Refresh(true) end end})
	Main:Toggle({Name = "Loop animation", Flag = "VD_Anim_Loop", Callback = function(State)
		if Anim.Track then pcall(function() Anim.Track.Looped = State end) end
	end})
	Main:Slider({Name = "Animation speed", Flag = "VD_Anim_Speed", Min = 0.1, Max = 3, Default = 1, Decimal = 0.05, Ending = "x", Callback = function(Value)
		if Anim.Track then pcall(function() Anim.Track:AdjustSpeed(Value) end) end
	end})
	Main:Toggle({Name = "Record animations players play", Flag = "VD_Anim_Record", Default = true})
	Main:TextBox({Name = "New name", Flag = "VD_Anim_RenameText", Max = 40})
	Main:Button({Name = "Rename selected animation", Callback = function()
		if Anim.RenameSelected then Anim.RenameSelected(Get("VD_Anim_RenameText")) end
	end})
	Main:Label({Message = "Play animation key (play / stop)"}):Keybind({Flag = "VD_Anim_Key", Default = Enum.KeyCode.H, UseMode = false})
	--
	local EmoteNames = {}
	local EmoteFolder = game:GetService("ReplicatedStorage"):WaitForChild("Emotes", 5)
	if EmoteFolder then
		for _, Child in EmoteFolder:GetChildren() do
			if Child:IsA("Folder") then table.insert(EmoteNames, Child.Name) end
		end
	end
	table.sort(EmoteNames)
	EmoteList = SelectableList(Emotes:List({Flag = "VD_Emote_Name", Size = LIST_ROWS_5}))
	for Index, Name in EmoteNames do EmoteList:AddValue(Name, nil, Index) end
