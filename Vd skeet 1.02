	ThirdPersonToggle = Main:Toggle({Name = "Third person (killer)", Flag = "VD_Misc_ThirdPerson"})
	Main:Label({Message = "Third person key"}):Keybind({Flag = "VD_Misc_ThirdPersonKey", Default = Enum.KeyCode.V, UseMode = false})
