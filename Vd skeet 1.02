--
-- Lists (5 rows visible, scroll / search) that remember their selection in configs
local LIST_ROWS_5 = 120 -- 18 px search box + 2 px border + 5 x 20 px rows
local function SelectableList(List)
	function List:Set(Value)
		if type(Value) ~= "string" then return end -- "Disable all" sends false
		if not self:Select(Value) then self.Pending = Value end
	end
	return List
end
