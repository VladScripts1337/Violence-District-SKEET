--
-- Noclip (Main - Survivor toggle + key)
local Noclip = {Parts = {}}
Connect(RunService.Stepped, function()
	local Active = Get("VD_Noclip_On") == true
	local Character = Client.Character
	if Active and Character then
		for _, Part in Character:GetDescendants() do
			if Part:IsA("BasePart") and Part.CanCollide then
				Noclip.Parts[Part] = true
				Part.CanCollide = false
			end
		end
	elseif not Active and next(Noclip.Parts) then
		for Part in Noclip.Parts do
			if Part.Parent then Part.CanCollide = true end
		end
		table.clear(Noclip.Parts)
	end
end)
--
-- Anti-fling (Misc): protection from other players' fling scripts. Normal body blocking stays as it is.
--   1. A player whose character moves or spins absurdly fast (any part, not just the root), or who carries fling
--      movers (BodyAngularVelocity / BodyThrust / AngularVelocity...), loses collision on YOUR client while it lasts
--      (+3 s), so their parts can't push you. Everyone else keeps colliding.
--   2. If you still get launched, your velocity is zeroed (before and after physics) and you're put back where you
--      last stood on the ground.
local AntiFling = {Flagged = {}, Saved = {}, SafeCFrame = nil, SafeTime = 0, LastRescue = 0, LastNotify = 0, LastScan = 0}
local FLING_SPIN = 30   -- rad/s on any part of another player (running / vaulting stays well below)
local FLING_SPEED = 100 -- studs/s on any part of another player (lunges and sprints are ~20-50)
local FLING_HOLD = 3    -- s a flagged player stays non-collidable after they calm down
local SELF_SPIN = 30    -- your own root
local SELF_SPEED = 100  -- your own root, horizontal
local SELF_UP = 80      -- your own root, upward (a jump is ~50)
--
local function RestoreFlingCollision(Player)
	for Part, Owner in AntiFling.Saved do
		if Player == nil or Owner == Player then
			if Part.Parent then Part.CanCollide = true end
			AntiFling.Saved[Part] = nil
		end
	end
end
--
local function CharacterIsFlinging(Character)
	for _, Part in Character:GetChildren() do
		if Part:IsA("BasePart") then
			if Part.AssemblyAngularVelocity.Magnitude > FLING_SPIN or Part.AssemblyLinearVelocity.Magnitude > FLING_SPEED then
				return true
			end
		end
	end
	return false
end
--
-- Only movers that are actually set to fling values count (the game may use weak ones for its own movement)
local function CharacterHasFlingMover(Character)
	for _, Object in Character:GetDescendants() do
		local Class = Object.ClassName
		if Class == "BodyAngularVelocity" and Object.AngularVelocity.Magnitude > FLING_SPIN then return true end
		if Class == "AngularVelocity" and Object.Enabled and Object.AngularVelocity.Magnitude > FLING_SPIN then return true end
		if Class == "BodyThrust" and Object.Force.Magnitude > 1e4 then return true end
		if Class == "Torque" and Object.Enabled and Object.Torque.Magnitude > 1e5 then return true end
		if Class == "BodyVelocity" and Object.Velocity.Magnitude > FLING_SPEED then return true end
	end
	return false
end
--
local function StopOwnLaunch(Root, Now, Rescue)
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero
	if Rescue and AntiFling.SafeCFrame and Now - AntiFling.LastRescue > 0.25 then
		Root.CFrame = AntiFling.SafeCFrame
		AntiFling.LastRescue = Now
	end
	if Now - AntiFling.LastNotify > 3 then
		AntiFling.LastNotify = Now
		Library:Notify({Message = "Anti-fling: launch stopped", Delay = 1.5})
	end
end
--
local function OwnLaunch(Character, Root)
	local Linear, Angular = Root.AssemblyLinearVelocity, Root.AssemblyAngularVelocity
	local Horizontal = Vector3.new(Linear.X, 0, Linear.Z).Magnitude
	-- ragdolled: the game throws you around a bit itself, so only react to clearly absurd values
	local Scale = Character:GetAttribute("Ragdolled") and 3 or 1
	return Angular.Magnitude > SELF_SPIN * Scale or Horizontal > SELF_SPEED * Scale or Linear.Y > SELF_UP * Scale
end
--
local function OwnAntiFlingParts()
	local Character, Root, Humanoid = GetCharacterParts(Client)
	if not Root or Root.Anchored or Character:GetAttribute("IsCarried") or Character:GetAttribute("IsHooked") then
		return nil -- the game moves you itself here
	end
	return Character, Root, Humanoid
end
--
-- Before physics: pause flingers' collision, catch a launch left over from the last frame
Connect(RunService.Stepped, function()
	if not Get("VD_Misc_AntiFling") then
		if next(AntiFling.Saved) or next(AntiFling.Flagged) then
			RestoreFlingCollision(nil)
			table.clear(AntiFling.Flagged)
		end
		return
	end
	local Now = os.clock()
	local ScanMovers = Now - AntiFling.LastScan > 0.2
	if ScanMovers then AntiFling.LastScan = Now end
	for _, Player in Players:GetPlayers() do
		if Player ~= Client then
			local Character = Player.Character
			if Character and (CharacterIsFlinging(Character) or (ScanMovers and CharacterHasFlingMover(Character))) then
				if not AntiFling.Flagged[Player] then
					Library:Notify({Message = "Anti-fling: " .. Player.Name .. " is flinging, their collision is off for you", Delay = 2})
				end
				AntiFling.Flagged[Player] = Now
			end
			local FlaggedAt = AntiFling.Flagged[Player]
			if FlaggedAt and (not Character or Now - FlaggedAt > FLING_HOLD) then
				AntiFling.Flagged[Player] = nil
				RestoreFlingCollision(Player)
			elseif FlaggedAt then
				for _, Part in Character:GetDescendants() do
					if Part:IsA("BasePart") and Part.CanCollide then
						AntiFling.Saved[Part] = Player
						Part.CanCollide = false
					end
				end
			end
		end
	end
	local Character, Root = OwnAntiFlingParts()
	if Root and OwnLaunch(Character, Root) then StopOwnLaunch(Root, Now, false) end
end)
--
-- After physics: undo a launch on your own character and put it back
Connect(RunService.Heartbeat, function()
	if not Get("VD_Misc_AntiFling") then AntiFling.SafeCFrame = nil return end
	local Character, Root, Humanoid = OwnAntiFlingParts()
	if not Root then AntiFling.SafeCFrame = nil return end
	local Now = os.clock()
	if OwnLaunch(Character, Root) then
		StopOwnLaunch(Root, Now, true)
	elseif Now - AntiFling.SafeTime > 0.1 then
		if Humanoid.FloorMaterial ~= Enum.Material.Air then AntiFling.SafeCFrame = Root.CFrame end -- last calm spot on the ground
		AntiFling.SafeTime = Now
	end
end)
Connect(Players.PlayerRemoving, function(Player)
	AntiFling.Flagged[Player] = nil
	RestoreFlingCollision(Player)
end)
--
-- Anti-aim: spins the character model only (camera untouched)
local AntiAim = {Angle = 0, Active = false}
--
local function UpdateAntiAim(DeltaTime)
	local _, Root, Humanoid = GetCharacterParts(Client)
	if Get("VD_Misc_AntiAim") and Root then
		AntiAim.Angle = (AntiAim.Angle + math.rad((Get("VD_Misc_SpinSpeed") or 20) * 36) * DeltaTime) % (math.pi * 2)
		Humanoid.AutoRotate = false
		Root.CFrame = CFrame.new(Root.Position) * CFrame.Angles(0, AntiAim.Angle, 0)
		AntiAim.Active = true
	elseif AntiAim.Active then
		if Humanoid then Humanoid.AutoRotate = true end
		AntiAim.Active = false
	end
end
--
-- Third person for killers: same path as the game's KillerDebugConfig.THIRD_PERSON (Classic camera, zoom 8-12, head visible)
local ThirdPerson = {Active = false}
local CollectionService = game:GetService("CollectionService")
--
local function SetViewmodelHidden(Hidden)
	local Camera = Workspace.CurrentCamera
	local Viewmodel = Camera and Camera:FindFirstChild("VM")
	if not Viewmodel then return end
	for _, Part in Viewmodel:GetDescendants() do
		if Part:IsA("BasePart") then Part.LocalTransparencyModifier = Hidden and 1 or 0 end
	end
end
--
local function SetHeadVisible(Character, Visible)
	local Head = Character:FindFirstChild("Head")
	if Head then Head.LocalTransparencyModifier = Visible and 0 or 1 end
	for _, Child in Character:GetChildren() do
		if Child:IsA("Accessory") and CollectionService:HasTag(Child, "HeadAccessory") then
			local Handle = Child:FindFirstChild("Handle")
			if Handle then Handle.LocalTransparencyModifier = Visible and 0 or 1 end
		end
	end
end
--
local function UpdateThirdPerson()
	local Character = Client.Character
	local Wanted = Get("VD_Misc_ThirdPerson") == true and IsKiller(Client) and Character ~= nil
	if Wanted then
		Client.CameraMode = Enum.CameraMode.Classic
		if Client.CameraMinZoomDistance ~= 8 then Client.CameraMinZoomDistance = 8 end
		if Client.CameraMaxZoomDistance ~= 12 then Client.CameraMaxZoomDistance = 12 end
		SetHeadVisible(Character, true)
		SetViewmodelHidden(true)
		ThirdPerson.Active = true
	elseif ThirdPerson.Active then
		ThirdPerson.Active = false
		if IsKiller(Client) then
			Client.CameraMinZoomDistance = 0.5
			Client.CameraMaxZoomDistance = 0.5
			if Character then SetHeadVisible(Character, false) end
		end
		SetViewmodelHidden(false)
	end
end
--
-- Cursor: free while the menu is open, restored when it closes
local Cursor = {Saved = nil}
local ModalButton = Instance.new("TextButton")
ModalButton.BackgroundTransparency = 1
ModalButton.Text = ""
ModalButton.Size = UDim2.fromOffset(0, 0)
ModalButton.Modal = true
ModalButton.Visible = false
ModalButton.Parent = BoxGui
--
local function UpdateCursor()
	if Window.Visible then
		if not Cursor.Saved then
			Cursor.Saved = {Behavior = UserInputService.MouseBehavior, Icon = UserInputService.MouseIconEnabled}
		end
		ModalButton.Visible = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	else
		ModalButton.Visible = false
		if Cursor.Saved then
			UserInputService.MouseBehavior = Cursor.Saved.Behavior
			UserInputService.MouseIconEnabled = Cursor.Saved.Icon
			Cursor.Saved = nil
		end
		if ThirdPerson.Active then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter -- killers turn with the mouse like in first person
		end
	end
end
--
-- Aspect ratio (stretched): scale the camera's Y axis after everything else, undo it before the next frame
local Aspect = {Original = nil, Applied = nil}
--
local function RestoreAspect()
	local Camera = Workspace.CurrentCamera
	if Camera and Aspect.Applied and Camera.CFrame == Aspect.Applied then
		Camera.CFrame = Aspect.Original
	end
	Aspect.Applied = nil
end
--
local function ApplyAspect()
	local Camera = Workspace.CurrentCamera
	local Percent = Get("VD_W_Aspect") or 0
	if not Camera or Percent <= 0 then return end
	local Scale = 1 - 0.25 * math.clamp(Percent, 0, 100) / 100 -- 1 = 16:9, 0.75 = 4:3 stretched
	Aspect.Original = Camera.CFrame
	Aspect.Applied = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, Scale, 0, 0, 0, 1)
	Camera.CFrame = Aspect.Applied
end
--
-- Trail
local Trail = {}
--
local function RainbowSequence(Offset)
	local Points = {}
	for Index = 0, 6 do
		local Alpha = Index / 6
		table.insert(Points, ColorSequenceKeypoint.new(Alpha, Color3.fromHSV((Alpha + Offset) % 1, 1, 1)))
	end
	return ColorSequence.new(Points)
end
--
-- Trail.Items = {{Object, A0, A1, Part}}: one ribbon at the soles ("Feet") or one per leg ("Both legs")
Trail.Items = {}
local TRAIL_LEGS = {
	{"LeftFoot", "Left Leg", "LeftLowerLeg"},   -- R15 foot first, then R6 leg
	{"RightFoot", "Right Leg", "RightLowerLeg"},
}
--
local function ClearTrail()
	for _, Item in Trail.Items do
		pcall(function() Item.Object:Destroy(); Item.A0:Destroy(); Item.A1:Destroy() end)
	end
	table.clear(Trail.Items)
	Trail.Character, Trail.Mode = nil, nil
end
--
local function NewTrailItem(Part)
	local A0 = Instance.new("Attachment"); A0.Name = "\0"; A0.Parent = Part
	local A1 = Instance.new("Attachment"); A1.Name = "\0"; A1.Parent = Part
	local Object = Instance.new("Trail")
	Object.Name = "\0"
	Object.Attachment0, Object.Attachment1 = A0, A1
	Object.Lifetime = 0.7
	Object.LightEmission = 0.6
	Object.FaceCamera = true
	Object.Transparency = NumberSequence.new(0.15, 1)
	Object.Parent = Part
	return {Object = Object, A0 = A0, A1 = A1, Part = Part}
end
--
-- Distance from the HumanoidRootPart centre down to the soles
local function GetFeetOffset(Character, Root, Humanoid)
	if Humanoid.RigType == Enum.HumanoidRigType.R15 then
		return Root.Size.Y / 2 + Humanoid.HipHeight
	end
	local Leg = Character:FindFirstChild("Left Leg") or Character:FindFirstChild("Right Leg")
	return Root.Size.Y / 2 + (Leg and Leg.Size.Y or 2) + Humanoid.HipHeight
end
--
local function UpdateTrail()
	local Character, Root, Humanoid = GetCharacterParts(Client)
	if not Get("VD_Self_Trail") or not Root then
		if #Trail.Items > 0 then ClearTrail() end
		return
	end
	local Mode = Get("VD_Self_TrailOrigin") or "Feet"
	--
	-- Rebuild on respawn, mode change, or when a part we sit on was removed
	local Valid = Trail.Character == Character and Trail.Mode == Mode and #Trail.Items > 0
	if Valid then
		for _, Item in Trail.Items do
			if not Item.Object.Parent or not Item.A0.Parent or not Item.A1.Parent or Item.Part.Parent ~= Character then Valid = false break end
		end
	end
	if not Valid then
		ClearTrail()
		if Mode == "Both legs" then
			for _, Names in TRAIL_LEGS do
				for _, Name in Names do
					local Part = Character:FindFirstChild(Name)
					if Part and Part:IsA("BasePart") then table.insert(Trail.Items, NewTrailItem(Part)) break end
				end
			end
		end
		if #Trail.Items == 0 then -- "Feet", or no legs found: single ribbon on the root at sole height
			table.insert(Trail.Items, NewTrailItem(Root))
		end
		Trail.Character, Trail.Mode = Character, Mode
	end
	--
	-- Ribbon starts at the soles and goes up by Width (FaceCamera keeps it facing you)
	local Width = math.max(Get("VD_Self_TrailWidth") or 1, 0.05)
	local Color = Get("VD_Self_TrailRainbow") and RainbowSequence(os.clock() * 0.25)
		or ColorSequence.new(GetColor("VD_Self_TrailColor", Color3.fromRGB(150, 110, 255)))
	for _, Item in Trail.Items do
		local Bottom = (Item.Part == Root and -GetFeetOffset(Character, Root, Humanoid) or -Item.Part.Size.Y / 2) + 0.05
		Item.A0.Position = Vector3.new(0, Bottom, 0)
		Item.A1.Position = Vector3.new(0, Bottom + Width, 0)
		Item.Object.Color = Color
	end
end
--
-- China hat (Drawing): filled cone + ring above the head, like the CS one
local HAT_SEGMENTS = 30
local Hat = {Triangles = {}, Lines = {}, Ready = false}
--
local function SetupHat()
	if Hat.Ready or not Drawing then return Hat.Ready end
	for Index = 1, HAT_SEGMENTS do
		local Triangle = Drawing.new("Triangle")
		Triangle.Filled = true
		Triangle.Thickness = 1
		Triangle.Transparency = 0.45
		Triangle.Visible = false
		Hat.Triangles[Index] = Triangle
		local Line = Drawing.new("Line")
		Line.Thickness = 2
		Line.Transparency = 1
		Line.Visible = false
		Line.ZIndex = 2
		Hat.Lines[Index] = Line
	end
	Hat.Ready = true
	return true
end
--
local function HideHat()
	for Index = 1, #Hat.Triangles do
		Hat.Triangles[Index].Visible = false
		Hat.Lines[Index].Visible = false
	end
end
--
local function UpdateHat()
	if not Get("VD_Self_Hat") then if Hat.Ready then HideHat() end return end
	if not SetupHat() then return end
	local Camera = Workspace.CurrentCamera
	local Character = Client.Character
	local Head = Character and Character:FindFirstChild("Head")
	if not Camera or not Head or Head.LocalTransparencyModifier > 0.9 or (Camera.CFrame.Position - Head.Position).Magnitude < 2 then
		HideHat()
		return
	end
	--
	local Top = Head.Size.Y / 2
	local Apex = Camera:WorldToViewportPoint((Head.CFrame * CFrame.new(0, Top + 0.85, 0)).Position)
	local Points = {}
	for Index = 1, HAT_SEGMENTS do
		local Angle = (Index - 1) / HAT_SEGMENTS * math.pi * 2
		local Point = Camera:WorldToViewportPoint((Head.CFrame * CFrame.new(math.cos(Angle) * 1.6, Top + 0.05, math.sin(Angle) * 1.6)).Position)
		if Point.Z <= 0 then HideHat() return end
		Points[Index] = Vector2.new(Point.X, Point.Y)
	end
	if Apex.Z <= 0 then HideHat() return end
	--
	local Rainbow = Get("VD_Self_HatRainbow")
	local Color = GetColor("VD_Self_HatColor", Color3.fromRGB(150, 110, 255))
	local Offset = os.clock() * 0.2
	local ApexPoint = Vector2.new(Apex.X, Apex.Y)
	for Index = 1, HAT_SEGMENTS do
		local Next = Points[Index % HAT_SEGMENTS + 1]
		local SegmentColor = Rainbow and Color3.fromHSV(((Index - 1) / HAT_SEGMENTS + Offset) % 1, 1, 1) or Color
		local Triangle = Hat.Triangles[Index]
		Triangle.PointA, Triangle.PointB, Triangle.PointC = ApexPoint, Points[Index], Next
		Triangle.Color = SegmentColor
		Triangle.Visible = true
		local Line = Hat.Lines[Index]
		Line.From, Line.To = Points[Index], Next
		Line.Color = SegmentColor
		Line.Visible = true
	end
end
--
-- World Effects: rain / snow emitters on an invisible part that follows the camera (local only)
local Weather = {}
local WEATHER = {
	Rain = {Flag = "VD_FX_Rain", ColorFlag = "VD_FX_RainColor", Default = Color3.fromRGB(170, 200, 255), Setup = function(Emitter)
		Emitter.Rate = 700
		Emitter.Lifetime = NumberRange.new(0.7, 0.9)
		Emitter.Speed = NumberRange.new(70, 85)
		Emitter.Size = NumberSequence.new(0.12)
		Emitter.Squash = NumberSequence.new(2.5) -- stretch into streaks
		Emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		Emitter.Transparency = NumberSequence.new(0.35)
		Emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	end},
	Snow = {Flag = "VD_FX_Snow", ColorFlag = "VD_FX_SnowColor", Default = Color3.fromRGB(255, 255, 255), Setup = function(Emitter)
		Emitter.Rate = 350
		Emitter.Lifetime = NumberRange.new(7, 9)
		Emitter.Speed = NumberRange.new(5, 8)
		Emitter.SpreadAngle = Vector2.new(25, 25)
		Emitter.Size = NumberSequence.new(0.25)
		Emitter.RotSpeed = NumberRange.new(-90, 90)
		Emitter.Transparency = NumberSequence.new(0.1)
		Emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	end},
}
--
local function UpdateWeather()
	local Camera = Workspace.CurrentCamera
	local Any = false
	for Kind, Config in WEATHER do
		local Enabled = Get(Config.Flag) == true
		Any = Any or Enabled
		local Emitter = Weather[Kind]
		if Enabled and not Emitter then
			if not Weather.Part or not Weather.Part.Parent then
				local Part = Instance.new("Part")
				Part.Name = "\0"
				Part.Anchored, Part.CanCollide, Part.CanQuery, Part.CanTouch = true, false, false, false
				Part.Transparency = 1
				Part.Size = Vector3.new(160, 1, 160)
				Part.Parent = Workspace
				Weather.Part = Part
			end
			Emitter = Instance.new("ParticleEmitter")
			Emitter.Name = "\0"
			Emitter.EmissionDirection = Enum.NormalId.Bottom
			Emitter.Shape = Enum.ParticleEmitterShape.Box
			Emitter.LightInfluence = 0
			Emitter.Brightness = 1.5
			Config.Setup(Emitter)
			Emitter.Parent = Weather.Part
			Weather[Kind] = Emitter
		elseif not Enabled and Emitter then
			Emitter:Destroy()
			Weather[Kind] = nil
		end
		if Enabled and Weather[Kind] then
			Weather[Kind].Color = ColorSequence.new(GetColor(Config.ColorFlag, Config.Default))
		end
	end
	if Weather.Part then
		if Any and Camera then
			Weather.Part.CFrame = CFrame.new(Camera.CFrame.Position + Vector3.new(0, 45, 0))
		elseif not Any then
			Weather.Part:Destroy()
			Weather.Part = nil
		end
	end
end
--
-- Emotes (all of them, played locally on your Animator like VD Rewrite; the animation replicates)
function Emote.Stop()
	if Emote.Track then pcall(function() Emote.Track:Stop(0.2) end); Emote.Track = nil end
	if Emote.Sound then pcall(function() Emote.Sound:Stop(); Emote.Sound:Destroy() end); Emote.Sound = nil end
end
--
function Emote.Play()
	Emote.Stop()
	if Anim.Stop then Anim.Stop() end
	local Name = Get("VD_Emote_Name")
	local Folder = Name and ReplicatedStorage:FindFirstChild("Emotes") and ReplicatedStorage.Emotes:FindFirstChild(Name)
	local Character, _, Humanoid = GetCharacterParts(Client)
	if not Folder or not Character then return end
	local AnimationId = Folder:GetAttribute("animationid")
	if typeof(AnimationId) ~= "string" or AnimationId == "" then return end
	local Animator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid
	local Animation = Instance.new("Animation")
	Animation.AnimationId = AnimationId
	Emote.Track = Animator:LoadAnimation(Animation)
	Emote.Track.Priority = Enum.AnimationPriority.Action
	Emote.Track:Play(0.1, 1, 1)
	local Song = Folder:GetAttribute("Song")
	if typeof(Song) == "string" and Song ~= "" then
		local Sound = Instance.new("Sound")
		Sound.SoundId = Song
		Sound.Parent = Character:FindFirstChild("Head") or Character.PrimaryPart
		Sound:Play()
		Emote.Sound = Sound
	end
end
--
-- ===================== Game animations (Misc) =====================
-- Where the list comes from:
--   1. animations the client scripts reference (survivor controller, killer moves, the gameplay preload list)
--   2. Animation objects that exist in the game right now (characters, ReplicatedStorage, the map)
--   3. everything any player's character plays while "Record" is on - this is how server-played ones
--      (hook sacrifice, carry, mori...) get in. Recorded ones are saved to VDSkeet/animations.json.
-- Naming (higher level wins, saved in the same file):
--   0 placeholder "Gameplay anim N"  1 what the player was doing (on hook, carried...)
--   2 readable name from the game / asset name  3 detected "Player death"  4 your own rename
local ANIM_FILE = Library.Folder .. "/animations.json"
local ANIM_MAX_RECORDED = 400
local KNOWN_ANIMATIONS = { -- {readable name, id, role} from SurvivorAnimationsController / Killers.Moves
	{"Walk", "101213085150090", "S"}, {"Run", "101474643265724", "S"},
	{"Walk (injured)", "140463265233127", "S"}, {"Run (injured)", "140101491310539", "S"},
	{"Crawl (knocked down)", "78719043959654", "S"}, {"Lying knocked down", "74118390445259", "S"},
	{"Crawl (knocked down, alt)", "106618106536124", "S"},
	{"Crouch (standing)", "73650663675588", "S"}, {"Crouch walk", "137834747905828", "S"},
	{"Idle (injured)", "137828867671413", "S"}, {"Walk (injured, alt)", "136695692860739", "S"},
	{"Sprint (injured)", "79999409695920", "S"}, {"Crouch (injured)", "84095653804164", "S"},
	{"Crouch walk (injured)", "102450923773041", "S"},
	{"Get hit", "126808696786184", "S"}, {"Get hit (from front)", "139830743437188", "S"},
	{"Get hit (from behind)", "121845674088602", "S"},
	{"Heal teammate", "110392490296814", "S"}, {"Heal fail", "87055506624885", "S"}, {"Being healed", "95836365038528", "S"},
	{"Open exit gate (lever)", "123959675151191", "S"}, {"Open exit gate (injured)", "134838390519433", "S"},
	{"Repair generator (side 1)", "83160743983246", "S"}, {"Repair generator (side 2)", "92960319113695", "S"},
	{"Repair generator (side 3)", "136553272065734", "S"}, {"Repair generator (side 4)", "101968088258360", "S"},
	{"Skill check fail (generator)", "83511010475014", "S"}, {"Carpenter lift", "112898159162549", "S"},
	{"Slasher ability 1", "134862031194933", "K"}, {"Slasher ability 2", "136973921948245", "K"},
	{"Stalker ability 1", "85894094209457", "K"}, {"Stalker ability 2", "110045688062234", "K"},
	{"Masked ability", "110441838520158", "K"}, {"Killer ability", "108114231850675", "K"},
	{"Hidden ability 1", "129570234771869", "K"}, {"Hidden ability 2", "130915693370693", "K"},
	{"Abysswalker ability 1", "86213737463907", "K"}, {"Abysswalker ability 2", "100395868673407", "K"},
	{"Veil ability", "110881025348309", "K"},
	{"Cure ability 1", "119792658841268", "K"}, {"Cure ability 2", "81019828986691", "K"},
}
local PRELOAD_ANIMATIONS = { -- StarterPlayerScripts.GameplayAssetWarmup: gameplay animations without names in the client
	"130204431712716", "90019569445276", "71705121963639", "95866729029878", "94463653254914", "122016055996306",
	"76744850905644", "71740408094534", "77477445889320", "114091541225946", "89848995572512", "85251709283908",
	"94593152176060", "92735745879757", "80453904687316", "100776253767213", "137909977525085", "98399167180852",
	"108302807013747", "121479930754687", "75890610078854", "118208418035577", "126081405469607", "132353867344883",
	"81486769001455", "126751859125353", "118019257172845", "134008802601598", "95496519823325", "126782232696074",
	"71629567835435", "79958416476841", "76672739799008",
}
-- Raw names (from the game / asset names) -> what it does. {all of, any of (or nil), name, role (or nil)}
local ANIM_RULES = {
	{{"unhook"}, nil, "Unhook teammate"},
	{{"hook"}, {"death", "die", "dead", "sacri", "kill", "under", "sink", "pull", "end"}, "Player death"},
	{{"hook"}, nil, "Hang survivor on hook", "K"},
	{{"hook"}, {"struggle", "resist", "fight"}, "Hook struggle"},
	{{"hook"}, {"self", "escape", "attempt", "free"}, "Hook escape attempt"},
	{{"hook"}, nil, "On hook"},
	{{"mori"}, nil, "Killer finisher (mori)"},
	{{"execut"}, nil, "Killer finisher (mori)"},
	{{"wiggle"}, nil, "Wiggle on killer's shoulder"},
	{{"pickup"}, nil, "Pick up survivor", "K"},
	{{"pickup"}, nil, "Picked up by killer"},
	{{"carr"}, nil, "Carry survivor", "K"},
	{{"carr"}, nil, "Carried by killer"},
}
--
Anim.Entries = {}   -- key (digits) -> {Key, Name, Level, Role, Label}
Anim.Labels = {}    -- list label -> entry
Anim.Saved = {Recorded = {}, Names = {}} -- persisted: Recorded[key] = {Name = raw, Role}, Names[key] = {Name, Level}
Anim.NameQueue = {}
Anim.Queued = {}
Anim.Watched = {}   -- Animator -> connection
Anim.Recent = {}    -- player -> recent tracks {Entry, Time, Context} (death detection)
Anim.DiedAt = {}    -- player -> os.clock() of the last death
Anim.Dirty = false
Anim.LiveOrder = 100000
--
local function AnimKey(Id)
	local Text = tostring(Id or "")
	return Text:match("(%d+)%s*$") or Text:match("%d+")
end
--
local function CleanAnimName(Name)
	Name = tostring(Name or ""):gsub("%c", ""):gsub("^%s+", ""):gsub("%s+$", "")
	if #Name > 40 then Name = Name:sub(1, 40) end
	return Name
end
--
local function IsGenericAnimName(Name)
	if type(Name) ~= "string" then return true end
	local Lower = Name:lower():gsub("[%s_%-]", "")
	return Lower == "" or Lower == "animation" or Lower == "track" or Lower == "anim" or Lower == "animationtrack"
		or Lower:match("^%d+$") ~= nil or Lower:match("^animation%d*$") ~= nil or Lower:match("^anim%d*$") ~= nil
end
--
-- "RunningVaultAnimation2" -> "Running vault 2"
local function HumanizeAnimName(Name)
	Name = CleanAnimName(Name)
	Name = Name:gsub("(%l)(%u)", "%1 %2"):gsub("(%a)(%d)", "%1 %2"):gsub("[_%-%.]+", " ")
	Name = Name:gsub("[Aa]nimation", ""):gsub("%f[%a][Aa]nim%f[%A]", "")
	Name = Name:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", ""):lower()
	return (Name:gsub("^%l", string.upper))
end
--
local function MatchAnimRule(Name, Role)
	local Flat = Name:lower():gsub("[%s_%-]", "")
	for _, Rule in ANIM_RULES do
		if not Rule[4] or Rule[4] == Role then
			local Ok = true
			for _, Word in Rule[1] do
				if not Flat:find(Word, 1, true) then Ok = false break end
			end
			if Ok and Rule[2] then
				Ok = false
				for _, Word in Rule[2] do
					if Flat:find(Word, 1, true) then Ok = true break end
				end
			end
			if Ok then return Rule[3] end
		end
	end
	return nil
end
--
-- Readable name from a raw game / asset name: returns name, level (nil, 0 if the raw name says nothing)
local function NameFromRaw(Raw, Role)
	local Clean = CleanAnimName(Raw)
	if IsGenericAnimName(Clean) then return nil, 0 end
	local Rule = MatchAnimRule(Clean, Role)
	if Rule then return Rule, 2 end
	local Human = HumanizeAnimName(Clean)
	if Human == "" then return nil, 0 end
	return Human, 2
end
--
local function AnimRoleOf(Player)
	if not Player then return nil end
	return (IsKiller(Player) and "K") or (IsSurvivor(Player) and "S") or nil
end
--
-- What the character is doing right now (used when the animation itself has no name)
local function AnimContext(Character)
	if not Character then return nil end
	if Character:GetAttribute("IsHooked") then return "hook", "On hook" end
	if Character:GetAttribute("IsCarried") then return "carried", "Carried by killer" end
	if Character:GetAttribute("Trapped") then return "trapped", "Caught in bear trap" end
	if Character:GetAttribute("IsUnhooking") then return "unhooking", "Unhook teammate" end
	if Character:GetAttribute("IsBeingHealed") then return "healed", "Being healed" end
	local State = Character:GetAttribute("ActionState")
	if type(State) == "string" and State ~= "" then return "action", HumanizeAnimName(State) end
	return nil
end
--
do -- load saved data
	local Ok, Data = pcall(function() return isfile(ANIM_FILE) and HttpService:JSONDecode(readfile(ANIM_FILE)) end)
	if Ok and type(Data) == "table" then
		if type(Data.Recorded) == "table" then Anim.Saved.Recorded = Data.Recorded end
		if type(Data.Names) == "table" then
			for Key, Value in Data.Names do
				if type(Value) == "table" and type(Value.Name) == "string" then
					Anim.Saved.Names[Key] = {Name = Value.Name, Level = tonumber(Value.Level) or 2}
				end
			end
		end
	end
end
--
function Anim.Save()
	if not Anim.Dirty then return end
	Anim.Dirty = false
	pcall(function() writefile(ANIM_FILE, HttpService:JSONEncode(Anim.Saved)) end)
end
--
local function AnimLabel(Entry)
	local Base = (Entry.Role and ("[" .. Entry.Role .. "] ") or "") .. Entry.Name
	local Label, Count = Base, 1
	while Anim.Labels[Label] and Anim.Labels[Label] ~= Entry do
		Count += 1
		Label = Base .. " " .. Count
	end
	return Label
end
--
local function QueueAnimName(Entry)
	if Entry.Level <= 1 and not Anim.Queued[Entry.Key] then
		Anim.Queued[Entry.Key] = true
		table.insert(Anim.NameQueue, Entry.Key)
	end
end
--
-- Adds one entry to the visible list (Order = position; live additions go to the bottom)
local function ShowAnimEntry(Entry, Order)
	Entry.Label = AnimLabel(Entry)
	Anim.Labels[Entry.Label] = Entry
	if AnimList then
		AnimList:AddValue(Entry.Label, nil, Order)
		if AnimList.Pending == Entry.Label and AnimList:Select(Entry.Label) then AnimList.Pending = nil end
	end
end
--
-- Rename if the new name is at least as trusted (Force = your own rename)
function Anim.SetName(Entry, Name, Level)
	Name = CleanAnimName(Name)
	if Name == "" or Level < Entry.Level or (Level == Entry.Level and Level < 4) then return false end
	Entry.Level = Level
	if Level >= 1 then
		Anim.Saved.Names[Entry.Key] = {Name = Name, Level = Level}
		Anim.Dirty = true
	end
	if Name == Entry.Name then return true end
	local OldLabel = Entry.Label
	local WasSelected = AnimList and OldLabel and AnimList:Get() == OldLabel
	Entry.Name = Name
	if OldLabel then
		Anim.Labels[OldLabel] = nil
		if AnimList then AnimList:RemoveValue(OldLabel) end
		Anim.LiveOrder += 1
		ShowAnimEntry(Entry, Anim.LiveOrder)
		if WasSelected then AnimList:Select(Entry.Label) end
	end
	return true
end
--
-- Called for every track a player's character starts (while recording is on). Returns the entry.
function Anim.Record(Id, Raw, Role, ContextName)
	local Key = AnimKey(Id)
	if not Key then return nil end
	local Name, Level = NameFromRaw(Raw, Role)
	if not Name and ContextName then Name, Level = ContextName, 1 end
	local Entry = Anim.Entries[Key]
	if Entry then
		if Name then Anim.SetName(Entry, Name, Level) end
		return Entry
	end
	local Count = 0
	for _ in Anim.Saved.Recorded do Count += 1 end
	if Count >= ANIM_MAX_RECORDED then return nil end
	Entry = {Key = Key, Name = Name or ("Gameplay anim #" .. Key:sub(-5)), Level = Name and Level or 0, Role = Role}
	local Cached = Anim.Saved.Names[Key]
	if Cached and Cached.Level > Entry.Level then Entry.Name, Entry.Level = Cached.Name, Cached.Level end
	Anim.Entries[Key] = Entry
	Anim.Saved.Recorded[Key] = {Name = CleanAnimName(Raw), Role = Role}
	if Entry.Level >= 1 and not Cached then Anim.Saved.Names[Key] = {Name = Entry.Name, Level = Entry.Level} end
	Anim.Dirty = true
	Anim.LiveOrder += 1
	ShowAnimEntry(Entry, Anim.LiveOrder)
	QueueAnimName(Entry)
	return Entry
end
--
-- Full rebuild: known + saved + Animation objects in the game, sorted (survivor, killer, other; then by name)
function Anim.Refresh(Notify)
	local Selected = (AnimList and AnimList:Get()) or (AnimList and AnimList.Pending)
	local Found = {}
	local function Add(Id, Name, Level, Role)
		local Key = AnimKey(Id)
		if not Key then return end
		local Entry = Found[Key]
		if not Entry then
			Entry = {Key = Key, Name = Name or ("Gameplay anim #" .. Key:sub(-5)), Level = Name and Level or 0, Role = Role}
			Found[Key] = Entry
		elseif Name and Level > Entry.Level then
			Entry.Name, Entry.Level = Name, Level
		end
		Entry.Role = Entry.Role or Role
	end
	--
	for _, Item in KNOWN_ANIMATIONS do
		Add(Item[2], Item[1], 2, Item[3])
		local Entry = Found[AnimKey(Item[2])]
		if Entry then Entry.Known = true end -- readable names from the game's code; never renamed automatically
	end
	for Index, Id in PRELOAD_ANIMATIONS do Add(Id, ("Gameplay anim %02d"):format(Index), 0, nil) end
	for Key, Data in Anim.Saved.Recorded do
		if type(Data) == "table" then
			local Name, Level = NameFromRaw(Data.Name, Data.Role)
			Add(Key, Name, Level, Data.Role)
		end
	end
	--
	local EmoteFolder = ReplicatedStorage:FindFirstChild("Emotes")
	local Characters = {}
	for _, Player in Players:GetPlayers() do
		if Player.Character then Characters[Player.Character] = Player end
	end
	for _, Root in {ReplicatedStorage, Workspace} do
		for _, Object in Root:GetDescendants() do
			if Object:IsA("Animation") and Object.AnimationId ~= "" and not (EmoteFolder and Object:IsDescendantOf(EmoteFolder)) then
				local Script = Object:FindFirstAncestorWhichIsA("LuaSourceContainer")
				if not (Script and Script.Name == "Animate") then -- default Roblox walk / jump / idle
					local Model = Object:FindFirstAncestorOfClass("Model")
					while Model and not Characters[Model] do Model = Model:FindFirstAncestorOfClass("Model") end
					local Role = Model and AnimRoleOf(Characters[Model]) or nil
					local Name, Level = NameFromRaw(Object.Name, Role)
					if not Name and Object.Parent then Name, Level = NameFromRaw(Object.Parent.Name, Role) end
					Add(Object.AnimationId, Name, Level, Role)
				end
			end
		end
	end
	--
	local Sorted = {}
	for Key, Entry in Found do
		local Cached = Anim.Saved.Names[Key]
		if Cached and Cached.Level > Entry.Level then Entry.Name, Entry.Level = Cached.Name, Cached.Level end
		table.insert(Sorted, Entry)
	end
	local RoleOrder = {S = 1, K = 2}
	table.sort(Sorted, function(A, B)
		local RA, RB = RoleOrder[A.Role] or 3, RoleOrder[B.Role] or 3
		if RA ~= RB then return RA < RB end
		if (A.Level == 0) ~= (B.Level == 0) then return A.Level ~= 0 end -- placeholders last
		return A.Name:lower() < B.Name:lower()
	end)
	--
	table.clear(Anim.Entries)
	table.clear(Anim.Labels)
	if AnimList then AnimList:Clear() end
	for Index, Entry in Sorted do
		Anim.Entries[Entry.Key] = Entry
		ShowAnimEntry(Entry, Index)
		QueueAnimName(Entry)
	end
	if AnimList then
		if not (Selected and AnimList:Select(Selected)) then
			AnimList.Pending = Selected
			if Sorted[1] and not AnimList:Get() then AnimList:Select(Sorted[1].Label) end
		end
		AnimList:ScrollToTop()
	end
	if Notify then Library:Notify({Message = ("Animations: %d in the list"):format(#Sorted), Delay = 2}) end
end
--
function Anim.RenameSelected(Name)
	local Label = AnimList and AnimList:Get()
	local Entry = Label and Anim.Labels[Label]
	Name = CleanAnimName(Name)
	if not Entry or Name == "" then
		Library:Notify({Message = "Select an animation and type a name first", Delay = 2})
		return
	end
	Anim.SetName(Entry, Name, 4)
	Anim.Save()
end
--
function Anim.Stop()
	if Anim.Track then pcall(function() Anim.Track:Stop(0.2) end); Anim.Track = nil end
end
--
function Anim.Play()
	Anim.Stop()
	Emote.Stop()
	local Label = AnimList and AnimList:Get()
	local Entry = Label and Anim.Labels[Label]
	local Character, _, Humanoid = GetCharacterParts(Client)
	if not Entry or not Character then return end
	local Animator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid
	local Animation = Instance.new("Animation")
	Animation.AnimationId = "rbxassetid://" .. Entry.Key
	local Ok, Track = pcall(function() return Animator:LoadAnimation(Animation) end)
	if not Ok or not Track then
		Library:Notify({Message = "Couldn't load " .. Entry.Name, Delay = 2})
		return
	end
	Track.Priority = Enum.AnimationPriority.Action4 -- above the game's own movement / action tracks
	Track.Looped = Get("VD_Anim_Loop") == true
	Anim.Track = Track -- before Play, so the recorder ignores our own track
	Track:Play(0.1, 1, Get("VD_Anim_Speed") or 1)
end
--
-- Death detection: the last track that started while the player was on the hook, up to 12 s before the death
-- (or up to 3 s after it), is the sacrifice animation -> "Player death"
local function NameDeathTrack(Item)
	if Item and Item.Entry and Item.Context == "hook" and not Item.Entry.Known then
		Anim.SetName(Item.Entry, "Player death", 3)
	end
end
--
local function OnAnimPlayerDied(Player)
	local Now = os.clock()
	if Anim.DiedAt[Player] and Now - Anim.DiedAt[Player] < 5 then return end -- several signals for one death
	Anim.DiedAt[Player] = Now
	local Recent = Anim.Recent[Player]
	if not Recent then return end
	for Index = #Recent, 1, -1 do
		local Item = Recent[Index]
		if Now - Item.Time <= 12 and Item.Context == "hook" and not Item.Entry.Known then
			NameDeathTrack(Item)
			break
		end
	end
	table.clear(Recent)
end
--
-- Recording: watch every player's Animator
local function WatchAnimator(Animator, Player)
	if Anim.Watched[Animator] then return end
	Anim.Watched[Animator] = Connect(Animator.AnimationPlayed, function(Track)
		if not Get("VD_Anim_Record") or Track == Anim.Track or Track == Emote.Track then return end
		local Animation = Track.Animation
		local Id = Animation and Animation.AnimationId
		if not Id or Id == "" then return end
		local Raw = Track.Name
		if IsGenericAnimName(Raw) then Raw = Animation.Name end
		local Character = Animator:FindFirstAncestorOfClass("Model")
		local Context, ContextName = AnimContext(Character)
		local Entry = Anim.Record(Id, Raw, AnimRoleOf(Player), ContextName)
		if not Entry then return end
		local Item = {Entry = Entry, Time = os.clock(), Context = Context}
		local Recent = Anim.Recent[Player] or {}
		Anim.Recent[Player] = Recent
		table.insert(Recent, Item)
		if #Recent > 8 then table.remove(Recent, 1) end
		local DiedAt = Anim.DiedAt[Player]
		if DiedAt and os.clock() - DiedAt <= 3 then NameDeathTrack(Item) end
	end)
end
--
local function WatchAnimCharacter(Player, Character)
	task.spawn(function()
		local Humanoid = Character:WaitForChild("Humanoid", 10)
		local Animator = Humanoid and (Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 10))
		if not Animator or Features.Unloaded then return end
		WatchAnimator(Animator, Player)
		Connect(Humanoid.Died, function() OnAnimPlayerDied(Player) end)
		Connect(Character.AncestryChanged, function()
			if not Character.Parent and Character:GetAttribute("IsHooked") then OnAnimPlayerDied(Player) end
		end)
	end)
end
--
local function WatchAnimPlayer(Player)
	if Player.Character then WatchAnimCharacter(Player, Player.Character) end
	Connect(Player.CharacterAdded, function(Character)
		if Player == Client then Anim.Track = nil end -- old track died with the old character
		WatchAnimCharacter(Player, Character)
	end)
	Connect(Player:GetAttributeChangedSignal("IsDead"), function()
		if Player:GetAttribute("IsDead") == true then OnAnimPlayerDied(Player) end
	end)
end
for _, Player in Players:GetPlayers() do WatchAnimPlayer(Player) end
Connect(Players.PlayerAdded, WatchAnimPlayer)
Connect(Players.PlayerRemoving, function(Player)
	Anim.Recent[Player] = nil
	Anim.DiedAt[Player] = nil
end)
--
-- Background: asset names for unnamed ids (one request at a time), save, drop dead Animators
Loop(0.5, function()
	local Key = table.remove(Anim.NameQueue, 1)
	if not Key then return end
	local Entry = Anim.Entries[Key]
	if not Entry or Entry.Level > 1 then return end
	local MarketplaceService = game:GetService("MarketplaceService")
	local Ok, Info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, tonumber(Key), Enum.InfoType.Asset)
	if Ok and type(Info) == "table" then
		local Name, Level = NameFromRaw(Info.Name, Entry.Role)
		if Name then Anim.SetName(Entry, Name, Level) end
	end
end)
Loop(10, function()
	Anim.Save()
	for Animator, Connection in Anim.Watched do
		if not Animator.Parent then
			pcall(function() Connection:Disconnect() end)
			Anim.Watched[Animator] = nil
		end
	end
end)
task.delay(2, function() if not Features.Unloaded then pcall(Anim.Refresh, false) end end)
--
-- ===================== World (Visuals) =====================
--
local ColorCorrection = Instance.new("ColorCorrectionEffect")
ColorCorrection.Name = "\0VDSkeet"
ColorCorrection.Enabled = false
ColorCorrection.Parent = Lighting
--
local Saved = {Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, ClockTime = Lighting.ClockTime, Sky = {}, Body = {}}
local CustomSky
--
function World.Ambience(State)
	if State then
		Lighting.Ambient = GetColor("VD_W_AmbInside", Color3.fromRGB(117, 76, 236))
		Lighting.OutdoorAmbient = GetColor("VD_W_AmbOutside", Color3.fromRGB(117, 76, 236))
	else
		Lighting.Ambient = Saved.Ambient
		Lighting.OutdoorAmbient = Saved.OutdoorAmbient
	end
end
--
function World.Time(State)
	if State then
		Lighting.ClockTime = Get("VD_W_Time") or 12
	else
		Lighting.ClockTime = Saved.ClockTime
	end
end
--
function World.Saturation(State)
	ColorCorrection.Enabled = State == true
	ColorCorrection.TintColor = GetColor("VD_W_SatTint", Color3.new(1, 1, 1))
	ColorCorrection.Saturation = (Get("VD_W_SatDensity") or 50) / 50 - 1
end
--
function World.Sky(State)
	local GameSky
	for _, Child in Lighting:GetChildren() do
		if Child:IsA("Sky") and Child ~= CustomSky then GameSky = Child break end
	end
	if GameSky and not Saved.Sky[GameSky] then
		local Faces = {}
		for _, Face in SKY_FACES do Faces[Face] = GameSky[Face] end
		Saved.Sky[GameSky] = Faces
	end
	--
	if CustomSky then CustomSky:Destroy(); CustomSky = nil end
	if State then
		local Ids = SKIES[Get("VD_W_SkyName") or "Redshift"] or SKIES.Redshift
		CustomSky = Instance.new("Sky")
		CustomSky.Name = "\0VDSkeet"
		CustomSky.CelestialBodiesShown = false
		for Index, Face in SKY_FACES do
			CustomSky[Face] = "rbxassetid://" .. Ids[Index]
			if GameSky then GameSky[Face] = "" end
		end
		CustomSky.Parent = Lighting
	else
		for Sky, Faces in Saved.Sky do
			if Sky.Parent then
				for Face, Value in Faces do Sky[Face] = Value end
			end
		end
		table.clear(Saved.Sky)
	end
end
--
local BODY_PARTS = {Torso = true, ["Left Leg"] = true, ["Right Leg"] = true, ["Left Arm"] = true, ["Right Arm"] = true, Head = true,
	UpperTorso = true, LowerTorso = true, LeftUpperArm = true, RightUpperArm = true, LeftLowerArm = true, RightLowerArm = true,
	LeftHand = true, RightHand = true, LeftUpperLeg = true, RightUpperLeg = true, LeftLowerLeg = true, RightLowerLeg = true, LeftFoot = true, RightFoot = true}
--
function World.Body(State)
	local Character = Client.Character
	if State and Character then
		local Material = Enum.Material[Get("VD_W_BodyMat") or "ForceField"]
		local Color = GetColor("VD_W_BodyColor", Color3.new(1, 1, 1))
		for _, Part in Character:GetDescendants() do
			if Part:IsA("BasePart") and (BODY_PARTS[Part.Name] or (Part.Parent and Part.Parent:IsA("Accessory"))) then
				if not Saved.Body[Part] then Saved.Body[Part] = {Material = Part.Material, Color = Part.Color} end
				Part.Material = Material
				Part.Color = Color
			end
		end
	elseif not State then
		for Part, Original in Saved.Body do
			if Part.Parent then
				Part.Material = Original.Material
				Part.Color = Original.Color
			end
		end
		table.clear(Saved.Body)
	end
end
--
-- ===================== Post-processing (Bloom / DOF / Sun rays / Color correction / Grayscale) =====================
-- Own effects live in Lighting and are recreated if the game clears them on a map change.
-- While our Bloom / DOF / Sun rays is on, the game's effect of the same class is disabled and restored afterwards.
local Post = {Effects = {}, Suppressed = {}, ToneMap = nil}
local POST_CLASSES = {Bloom = "BloomEffect", DOF = "DepthOfFieldEffect", SunRays = "SunRaysEffect", Grade = "ColorCorrectionEffect", Gray = "ColorCorrectionEffect"}
local POST_SUPPRESS = {BloomEffect = "VD_PP_Bloom", DepthOfFieldEffect = "VD_PP_DOF", SunRaysEffect = "VD_PP_SunRays"}
--
-- Tone curves: {contrast (log2), shadow lift, highlight gain, saturation}, applied under the sliders.
-- "Retro" uses Roblox's real ColorGradingEffect tonemapper when the client has it, otherwise this approximation.
local TONE_CURVES = {
	Linear = {0, 0, 0, 0},
	Filmic = {0.25, 0.02, -0.04, -0.05},
	Punchy = {0.5, -0.02, 0.04, 0.25},
	Soft   = {-0.35, 0.04, -0.03, -0.05},
	Faded  = {-0.5, 0.1, -0.06, -0.3},
	Retro  = {-0.25, 0, 0, -0.2},
}
--
local function PostEffect(Key)
	local Effect = Post.Effects[Key]
	if not Effect or Effect.Parent ~= Lighting then
		if Effect then pcall(Effect.Destroy, Effect) end
		Effect = Instance.new(POST_CLASSES[Key])
		Effect.Name = "\0VDSkeet"
		Effect.Enabled = false
		Post.Effects[Key] = Effect
		Effect.Parent = Lighting
	end
	return Effect
end
--
local function IsOwnPostEffect(Object)
	for _, Effect in Post.Effects do
		if Effect == Object then return true end
	end
	return false
end
--
local function SuppressGameEffects()
	local Camera = Workspace.CurrentCamera
	for _, Container in {Lighting, Camera} do
		for _, Child in Container:GetChildren() do
			local Flag = POST_SUPPRESS[Child.ClassName]
			if Flag and not IsOwnPostEffect(Child) then
				if Get(Flag) then
					-- remember the game's state (and pick up the game re-enabling it while we hold it off)
					if Post.Suppressed[Child] == nil or Child.Enabled then Post.Suppressed[Child] = Child.Enabled end
					if Child.Enabled then Child.Enabled = false end
				elseif Post.Suppressed[Child] ~= nil then
					Child.Enabled = Post.Suppressed[Child]
					Post.Suppressed[Child] = nil
				end
			end
		end
	end
	-- effects the game moved away or destroyed
	for Child, Enabled in Post.Suppressed do
		if Child.Parent ~= Lighting and (not Camera or Child.Parent ~= Camera) then
			if Child.Parent then pcall(function() Child.Enabled = Enabled end) end
			Post.Suppressed[Child] = nil
		end
	end
end
--
-- Retro tonemapper. Only the newest ColorGradingEffect in Lighting is used, so ours is removed (not just disabled)
-- when off, and re-parented if the game adds its own while ours is active. Returns true if the real effect is applied.
local function ApplyToneMapper(Wanted)
	if not Wanted then
		if Post.ToneMap and Post.ToneMap.Parent then Post.ToneMap.Parent = nil end
		return false
	end
	if not Post.ToneMap then
		local Ok, Effect = pcall(Instance.new, "ColorGradingEffect")
		if not Ok or not Effect then return false end
		Effect.Name = "\0VDSkeet"
		if not pcall(function() Effect.TonemapperPreset = Enum.TonemapperPreset.Retro end) then
			Effect:Destroy()
			return false
		end
		Post.ToneMap = Effect
	end
	Post.ToneMap.Enabled = true
	if Post.ToneMap.Parent ~= Lighting then Post.ToneMap.Parent = Lighting end
	return true
end
--
-- Sliders are -200..200 (0 = unchanged). Highlights / Shadows / Contrast are folded into one linear curve
-- out = Gain * in + Offset, which is what ColorCorrectionEffect can do (Contrast around 0.5 + Brightness).
local function ApplyGrade(Grade)
	local GradeOn = Get("VD_PP_Grade") == true
	local Curve = Get("VD_PP_ToneCurve") or "Linear"
	local RealRetro = ApplyToneMapper(GradeOn and Curve == "Retro")
	local Preset = (RealRetro and TONE_CURVES.Linear) or TONE_CURVES[Curve] or TONE_CURVES.Linear
	local function Value(Flag) return (Get(Flag) or 0) / 100 end -- -2..2
	--
	local Gain, Offset = 1, 0
	local Lift = Preset[2] + Value("VD_PP_Shadows") * 0.2 -- raise / crush blacks, white stays put
	Gain, Offset = Gain * (1 - Lift), Offset * (1 - Lift) + Lift
	local WhiteGain = 1 + Preset[3] + Value("VD_PP_Highlights") * 0.25 -- brighten / dim the top end, black stays put
	Gain, Offset = Gain * WhiteGain, Offset * WhiteGain
	local Contrast = 2 ^ (Preset[1] + Value("VD_PP_Contrast")) -- -200 = x0.25, +200 = x4
	Gain, Offset = Gain * Contrast, (Offset - 0.5) * Contrast + 0.5
	Grade.Contrast = Gain - 1
	Grade.Brightness = Offset - 0.5 + 0.5 * Gain
	--
	-- Saturation: -200 = grayscale, +200 = x3. Vibrance is a gentler saturation (Roblox has no per-pixel vibrance).
	local Saturation = Value("VD_PP_Saturation")
	local Vibrance = Value("VD_PP_Vibrance")
	Saturation = (Saturation < 0 and Saturation / 2 or Saturation) + (Vibrance < 0 and Vibrance / 4 or Vibrance / 2)
	Grade.Saturation = math.max(Preset[4] + Saturation, -1)
	--
	-- Temperature: + warm / - cool. Tint: + magenta / - green.
	local Temperature = math.clamp(Value("VD_PP_Temperature") / 2, -1, 1)
	local Tint = math.clamp(Value("VD_PP_Tint") / 2, -1, 1)
	local Red, Green, Blue = 1, 1, 1
	if Temperature > 0 then
		Green, Blue = Green * (1 - 0.12 * Temperature), Blue * (1 - 0.45 * Temperature)
	else
		Red, Green = Red * (1 + 0.45 * Temperature), Green * (1 + 0.12 * Temperature)
	end
	if Tint > 0 then
		Green = Green * (1 - 0.35 * Tint)
	else
		Red, Blue = Red * (1 + 0.35 * Tint), Blue * (1 + 0.35 * Tint)
	end
	Grade.TintColor = Color3.new(Red, Green, Blue)
	Grade.Enabled = GradeOn
end
--
function World.Post()
	local Bloom = PostEffect("Bloom")
	Bloom.Intensity = Get("VD_PP_BloomIntensity") or 1
	Bloom.Size = Get("VD_PP_BloomSize") or 24
	Bloom.Threshold = Get("VD_PP_BloomThreshold") or 0.8
	Bloom.Enabled = Get("VD_PP_Bloom") == true
	--
	local DOF = PostEffect("DOF")
	DOF.FarIntensity = (Get("VD_PP_DOFFar") or 40) / 100
	DOF.NearIntensity = (Get("VD_PP_DOFNear") or 0) / 100
	DOF.FocusDistance = Get("VD_PP_DOFFocus") or 30
	DOF.InFocusRadius = Get("VD_PP_DOFRadius") or 20
	DOF.Enabled = Get("VD_PP_DOF") == true
	--
	local SunRays = PostEffect("SunRays")
	SunRays.Intensity = (Get("VD_PP_SunIntensity") or 25) / 100
	SunRays.Spread = (Get("VD_PP_SunSpread") or 50) / 100
	SunRays.Enabled = Get("VD_PP_SunRays") == true
	--
	ApplyGrade(PostEffect("Grade"))
	--
	local Gray = PostEffect("Gray")
	local Strength = (Get("VD_PP_GrayStrength") or 100) / 100
	Gray.Saturation = -Strength
	Gray.Contrast = 0.1 * Strength
	Gray.Enabled = Get("VD_PP_Gray") == true
	--
	SuppressGameEffects()
end
--
function World.PostActive()
	return Get("VD_PP_Bloom") or Get("VD_PP_DOF") or Get("VD_PP_SunRays") or Get("VD_PP_Grade") or Get("VD_PP_Gray")
		or next(Post.Suppressed) ~= nil or (Post.ToneMap ~= nil and Post.ToneMap.Parent ~= nil)
end
--
function World.PostCleanup()
	for _, Effect in Post.Effects do pcall(Effect.Destroy, Effect) end
	table.clear(Post.Effects)
	if Post.ToneMap then pcall(Post.ToneMap.Destroy, Post.ToneMap); Post.ToneMap = nil end
	for Child, Enabled in Post.Suppressed do
		if Child.Parent then pcall(function() Child.Enabled = Enabled end) end
	end
	table.clear(Post.Suppressed)
end
--
Connect(Lighting.ChildAdded, function(Child)
	local Flag = POST_SUPPRESS[Child.ClassName]
	if Flag and Get(Flag) and not IsOwnPostEffect(Child) then
		task.defer(function() pcall(SuppressGameEffects) end)
	elseif Child.ClassName == "ColorGradingEffect" and Child ~= Post.ToneMap and Post.ToneMap and Post.ToneMap.Parent == Lighting then
		task.defer(function() -- the game added its own grading: make ours the newest again
			pcall(function() Post.ToneMap.Parent = nil; Post.ToneMap.Parent = Lighting end)
		end)
	end
end)
--
Connect(Lighting:GetPropertyChangedSignal("Ambient"), function()
	if Get("VD_W_Ambience") then
		local Wanted = GetColor("VD_W_AmbInside", Lighting.Ambient)
		if Lighting.Ambient ~= Wanted then Lighting.Ambient = Wanted end
	else
		Saved.Ambient = Lighting.Ambient
	end
end)
Connect(Lighting:GetPropertyChangedSignal("OutdoorAmbient"), function()
	if Get("VD_W_Ambience") then
		local Wanted = GetColor("VD_W_AmbOutside", Lighting.OutdoorAmbient)
		if Lighting.OutdoorAmbient ~= Wanted then Lighting.OutdoorAmbient = Wanted end
	else
		Saved.OutdoorAmbient = Lighting.OutdoorAmbient
	end
end)
Connect(Lighting:GetPropertyChangedSignal("ClockTime"), function()
	if Get("VD_W_ForceTime") then
		local Wanted = Get("VD_W_Time") or 12
		if math.abs(Lighting.ClockTime - Wanted) > 0.01 then Lighting.ClockTime = Wanted end
	else
		Saved.ClockTime = Lighting.ClockTime
	end
end)
Connect(Lighting.ChildAdded, function(Child)
	if Child:IsA("Sky") and Child ~= CustomSky and Get("VD_W_Skybox") then
		task.wait()
		World.Sky(true)
	end
end)
--
-- ===================== Loops =====================
--
BindStep("VDSkeetAspectRestore", Enum.RenderPriority.First.Value, RestoreAspect)
BindStep("VDSkeetAim", Enum.RenderPriority.Camera.Value + 2, UpdateAimbots)
BindStep("VDSkeetAspect", Enum.RenderPriority.Last.Value + 2, ApplyAspect)
BindStep("VDSkeetSelf", Enum.RenderPriority.Last.Value + 3, function(DeltaTime)
	UpdateThirdPerson()
	UpdateAntiAim(DeltaTime)
	UpdateCursor()
	UpdateTrail()
	UpdateHat()
	UpdateWeather()
end)
BindStep("VDSkeetSkill", Enum.RenderPriority.Last.Value + 1, UpdateSkillCheck)
BindStep("VDSkeetBoxes", Enum.RenderPriority.Last.Value + 5, function()
	UpdateBoxes()
	UpdateCrosshair()
	if Get("VD_Fov_On") and Workspace.CurrentCamera then
		Workspace.CurrentCamera.FieldOfView = Get("VD_Fov_Value") or 90
	end
end)
--
Connect(RunService.Heartbeat, function(DeltaTime)
	UpdateSpeed()
	UpdateCrouchSpeed()
	UpdateStunAttribute()
	UpdateNoSlowdown()
	if Get("VD_Misc_AntiAim") then UpdateAntiAim(0) end -- keep the spun CFrame for replication
end)
--
Loop(UPDATE_RATE, function()
	local Map = Workspace:FindFirstChild("Map")
	if Map ~= Features.Map then
		WatchMap(Map)
	end
	UpdateHighlights()
	UpdateNames()
end)
--
Loop(0.5, function()
	SetTurnPatch(Get("VD_NoTurnLimit") == true)
	UpdateLunge()
	UpdateHitboxes()
	UpdateAntiBlindOverlay()
	if Get("VD_Auto_Parry") then
		HookParryClient()
		local Character = Client.Character
		if Character and (Character:FindFirstChild("Parrying Dagger", true) or Character:FindFirstChild("Parry Dagger", true)) then
			GetParryClient() -- warm the cache so the first parry isn't delayed by getgc
		end
	end
	if Get("VD_K_AntiBlind") or Get("VD_K_DoubleTap") then InstallNamecallHook() end
	if Get("VD_K_HiddenNoCD") then InstallHiddenHook() end
	if Get("VD_W_Body") then World.Body(true) end
	if World.PostActive() then World.Post() end -- re-create effects / re-pause the game's after a map change
end)
--
Connect(Client.Idled, function()
	if Get("VD_Misc_AntiAFK") then
		local VirtualUser = game:GetService("VirtualUser")
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end
end)
--
Connect(Players.PlayerRemoving, function(Player)
	RemoveBox(Player)
end)
--
do -- Unload cleanup
	local OldUnload = Library.Unload
	function Library:Unload()
		Features.Unloaded = true
		for _, Name in Features.RenderSteps do
			pcall(RunService.UnbindFromRenderStep, RunService, Name)
		end
		for _, Connection in Features.Connections do
			pcall(function() Connection:Disconnect() end)
		end
		for _, Connection in Features.MapConnections do
			pcall(function() Connection:Disconnect() end)
		end
		pcall(SetTurnPatch, false)
		pcall(Emote.Stop)
		pcall(Anim.Stop)
		pcall(RestoreFlingCollision, nil)
		pcall(function() Anim.Dirty = true; Anim.Save() end)
		pcall(function()
			for _, Object in Hat.Triangles do Object:Remove() end
			for _, Object in Hat.Lines do Object:Remove() end
			ClearTrail()
			if Weather.Part then Weather.Part:Destroy() end
			if Cursor.Saved then
				UserInputService.MouseBehavior = Cursor.Saved.Behavior
				UserInputService.MouseIconEnabled = Cursor.Saved.Icon
			end
			if AntiAim.Active then
				local _, _, Humanoid = GetCharacterParts(Client)
				if Humanoid then Humanoid.AutoRotate = true end
			end
			if ThirdPerson.Active then
				Library.Flags["VD_Misc_ThirdPerson"]:Set(false)
				UpdateThirdPerson()
			end
			if Crouch.Applied and Crouch.Controller then rawset(Crouch.Controller, "crouchSpeed", Crouch.Original or 6) end
			RestoreAspect()
		end)
		pcall(World.Ambience, false)
		pcall(World.Time, false)
		pcall(World.Sky, false)
		pcall(World.Body, false)
		pcall(World.PostCleanup)
		pcall(function()
			for Root, Original in Killer.Hitboxes do
				if Root.Parent then Root.Size, Root.Transparency, Root.CanCollide = Original.Size, Original.Transparency, Original.CanCollide end
			end
			local Character = Client.Character
			if Character then
				if Killer.Lunge then Character:SetAttribute("lungeboost", 1) end
				if Speed.Applied and math.abs((Character:GetAttribute("speedboost") or 1) - Speed.Applied) < 1e-4 then
					Character:SetAttribute("speedboost", Speed.Base)
				end
			end
		end)
		pcall(function() ColorCorrection:Destroy() end)
		pcall(function() HighlightFolder:Destroy() end)
		pcall(function() BoxGui:Destroy() end)
		return OldUnload(self)
	end
end
--
Window:SetTab(2)
Library:Init()
Library:Notify({Message = "Violence District loaded. Menu: Insert / RightShift", Delay = 4})
--
task.delay(1.5, function() -- after the library sets keybind defaults (task.delay(1)), so loaded binds stay
	local Name = Autoload.Get()
	local File = Name and (Library.ConfigFolder .. "/" .. Name .. ".cfg")
	if File and isfile(File) then
		local Ok, Error = pcall(function() Library:LoadConfig(readfile(File)) end)
		Library:Notify({Message = Ok and ("Autoload: loaded " .. Name) or ("Autoload failed: " .. tostring(Error)), Delay = 3})
	elseif Name then
		Autoload.Set(nil) -- the config was deleted outside the menu
	end
end)
