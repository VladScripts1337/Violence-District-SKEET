local Window = Library:Window({Name = "gamesense", CloseBind = Enum.KeyCode.Insert})
local VisualsTab  = Window:CreateTab({Icon = "rbxassetid://15453344494"})
local MainTab     = Window:CreateTab({Icon = "rbxassetid://15453313321"})
local MiscTab     = Window:CreateTab({Icon = "rbxassetid://15453335745"})
local PlayersTab  = Window:CreateTab({Icon = "rbxassetid://15453359751"})
local SettingsTab = Window:CreateTab({Icon = "rbxassetid://15453349637"})
local ConfigsTab  = Window:CreateTab({Icon = "rbxassetid://15453364412"})
--
-- Read a value anywhere: Get("VD_Aim_Smooth")
local function Get(FlagName)
	local Element = Library.Flags[FlagName]
	return Element and Element:Get()
end
getgenv().VDGet = Get
--
-- Autoload: name of the config loaded on every injection, stored in VDSkeet/autoload.txt
local Autoload = {File = Library.Folder .. "/autoload.txt", Label = nil}
function Autoload.Get()
	if not isfile(Autoload.File) then return nil end
	local Name = readfile(Autoload.File)
	if type(Name) ~= "string" or Name == "" then return nil end
	return Name
end
function Autoload.Set(Name)
	writefile(Autoload.File, Name or "")
	if Autoload.Label then Autoload.Label.Text = "Autoload: " .. (Name or "none") end
end
