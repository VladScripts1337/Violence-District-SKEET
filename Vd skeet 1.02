do -- Misc
	local Main = MiscTab:Section({Name = "Misc", Fill = true})
	local Emotes = MiscTab:Section({Name = "Emotes", Side = "Right", Fill = true})
	--
	Main:Toggle({Name = "Anti AFK", Flag = "VD_Misc_AntiAFK"})
	Main:Toggle({Name = "Anti-fling", Flag = "VD_Misc_AntiFling"})
	Main:Toggle({Name = "Anti-aim (spin model)", Flag = "VD_Misc_AntiAim"})
